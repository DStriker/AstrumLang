            lookup = data[@Unchecked index - 5u];
            if lookup != val1 and lookup != val2
            {
                return index - 5u;
            }
            lookup = data[@Unchecked index - 6u];
            if lookup != val1 and lookup != val2
            {
                return index - 6u;
            }
            lookup = data[@Unchecked index - 7u];
            if lookup != val1 and lookup != val2
            {
                return index - 7u;
            }

            index -%= 8;
        }

        while length >= 4u {
            length -= 4u;

            lookup := data[@Unchecked index];
            if lookup != val1 and lookup != val2
            {
                return index;
            }
            lookup = data[@Unchecked index - 1u];
            if lookup != val1 and lookup != val2
            {
                return index - 1u;
            }
            lookup = data[@Unchecked index - 2u];
            if lookup != val1 and lookup != val2
            {
                return index - 2u;
            }
            lookup = data[@Unchecked index - 3u];
            if lookup != val1 and lookup != val2
            {
                return index - 3u;
            }

            index -%= 4;
        }

        while length > 0 {
            --length;
            lookup := data[@Unchecked index];
            if lookup != val1 and lookup != val2 {
                return index;
            }
            --%index;
        }
        return null;
    }

