                                Unsafe.BitCast<u16>(values[@Unchecked 0])),
                        2 => SpanHelpers.IndexOfAnyExceptWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(values[@Unchecked 0]), Unsafe.BitCast<u16>(values[@Unchecked 1])),
                        3 => SpanHelpers.IndexOfAnyExceptWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(values[@Unchecked 0]), Unsafe.BitCast<u16>(values[@Unchecked 1]),
                                Unsafe.BitCast<u16>(values[@Unchecked 2])),
                        4 => SpanHelpers.IndexOfAnyExceptWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(values[@Unchecked 0]), Unsafe.BitCast<u16>(values[@Unchecked 1]), 
                                Unsafe.BitCast<u16>(values[@Unchecked 2]), Unsafe.BitCast<u16>(values[@Unchecked 3])),
                        5 => SpanHelpers.IndexOfAnyExceptWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(values[@Unchecked 0]), Unsafe.BitCast<u16>(values[@Unchecked 1]), 
                                Unsafe.BitCast<u16>(values[@Unchecked 2]), Unsafe.BitCast<u16>(values[@Unchecked 3]),
                                Unsafe.BitCast<u16>(values[@Unchecked 4])),
                        _ => SpanHelpers.IndexOfAnyExceptInternal(span, values)
                    };
                }
            }
            
            return SpanHelpers.IndexOfAnyExceptInternal(span, values);
        } else static if type TValuesReal is operator T {
            const simdSupported :== version(X86) or version(ARM);
            static if simdSupported and Builtin.IsBitwiseEquatable<T> {
                static if sizeof(T) == 1 {
                    return SpanHelpers.IndexOfAnyExceptByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
