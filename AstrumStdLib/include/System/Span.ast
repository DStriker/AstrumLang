package System;

public import Range;
public import Result;
public import Delegates;
public import System.Runtime.CompilerServices.Unsafe;
import System.Runtime.Intrinsics.Simd;
import InlineArray;

public ref struct <T> Span: ISelfEquatable, IAbstractSequence, ISequence<T> {
    public type ElementType = T;
    public type SpanType = self;

    private _data: &T;
    private _length: usize;

    public implicit this(span: MutableSpan<T>) noexcept == {
        this(span.GetDataReference(), span.Length);
    }

    public unsafe this(ptr: *const T, length: usize) == {
        this._data = ptr*;
        this._length = length;

        if ptr == null {
            throw Builtin.InvalidArgumentException();
        }
    }

    private this(in ref data: T, length: usize) noexcept == {
        this._data = data;
        this._length = length;
    }

    public implicit this<S: usize>(in ref arr: T[S]) noexcept == {
        this._data = arr.GetDataReference();
        this._length = S;
    }

    public this[index: i32] -> const ref T == {
        let realIndex := index as usize;
        if realIndex >= _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return Unsafe.Add(_data, realIndex);
    }
    @Unchecked
    public this[index: i32] -> const ref T == {
        return Unsafe.Add(_data, index as usize);
    }
    public this[index: Index] -> const ref T == {
        let realIndex := index.Offset(_length) as usize;

        if realIndex >= _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return Unsafe.Add(_data, realIndex);
    }
    @Unchecked
    public this[index: Index] -> const ref T == {
        return Unsafe.Add(_data, index.Offset(_length) as usize);
    }
    Get: (index: usize) -> T? == {
        if index >= _length {
            return null;
        }
        return Unsafe.Add(_data, index);
    }
    public this[range: IndexRange] -> self == {
        let start := range.Start.Offset(_length) as usize;
        let len := range.Length(_length);

        if (start + len) > _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return self(Unsafe.Add(_data, start), len);
    }
    @Unchecked
    public this[range: IndexRange] -> self == {
        return self(Unsafe.Add(_data, range.Start.Offset(_length) as usize), range.Length(_length));
    }

    public Slice: (start: usize) -> self == {
        if start >= _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return self(Unsafe.Add(_data, start), _length - start);
    }

    public Slice: (start: usize, length: usize) -> self == {
        if start + length >= _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return self(Unsafe.Add(_data, start), length);
    }

    public SliceUnchecked: (start: usize) -> self == {
        return self(Unsafe.Add(_data, start), _length - start);
    }

    public SliceUnchecked: (start: usize, length: usize) -> self == {
        return self(Unsafe.Add(_data, start), length);
    }

    public operator==: (other: self) -> bool noexcept == {
        return _length == other._length and Unsafe.AreSame(_data, other._data);
    }

    public GetLength: () -> usize noexcept ==> _length;
    public GetDataReference: () -> &T noexcept ==> _data;

    public ref struct Iterator: IAbstractIterator, IIterator<T> {
        public type ElementType = T;

        private _ref: &T;
        private _length: usize;
        private _index: usize;
        friend Span<T>;

        private this(span: Span<T>) noexcept == {
            this._ref = span.GetDataReference();
            this._length = span.Length;
            this._index = usize.MaxValue;
        }

        public mut MoveNext: () -> bool noexcept == {
            let newIndex := _index +% 1uz;
            if newIndex < _length {
                _index = newIndex;
                return true;
            }
            return false;
        }

        public mut Reset: () noexcept == {
            _index = usize.MaxValue;
        }

        public GetCurrent: () -> T == {
            return Unsafe.Add(_ref, _index);
        }

        public GetCurrentRef: () -> const ref T == {
            return Unsafe.Add(_ref, _index);
        }
    }
    public Iterate: () -> Iterator ==> Iterator(this);

    public static UnsafeCreate: (in ref data: T, length: usize) -> self == {
        return self(data, length);
    }

    // Searches for the specified value and returns true if found
    public Contains: (in ref val: T) -> bool == {
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        if consteval {
            for i in this {
                if i == val {
                    return true;
                }
            }
            return false;
        } else {
            if version(X86 or ARM) {
                static if Builtin.IsBitwiseEquatable<T> {
                    // SIMD path
                    static if sizeof(T) == 1 {
                        return SpanHelpers.ContainsByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(_data), _length), 
                            Unsafe.BitCast<byte>(val));
                    } else static if sizeof(T) == 2 {
                        return SpanHelpers.ContainsWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(_data), _length), 
                            Unsafe.BitCast<u16>(val));
                    } else static if sizeof(T) == 4 {
                        return SpanHelpers.ContainsDword(Span<u32>::UnsafeCreate(Unsafe.As<u32>(_data), _length), 
                            Unsafe.BitCast<u32>(val));
                    } else static if sizeof(T) == 8 {
                        return SpanHelpers.ContainsQword(Span<u64>::UnsafeCreate(Unsafe.As<u64>(_data), _length), 
                            Unsafe.BitCast<u64>(val));
                    }
                } else {
                    // Regular path
                    return SpanHelpers.ContainsGeneralCase(this, val);
                }
            } else {
                return SpanHelpers.ContainsGeneralCase(this, val);
            }
        }
    }

    public operator in: (in ref val: T) -> bool ==> Contains(val);

    // Searches for the specified value using the given EqualityComparer and returns true if found
    public Contains: (in ref val: T, equals: EqualityComparer<T>) -> bool => IndexOf(val, equals) != null;

    // Searches for the specified subspan and returns true if found
    public Contains: (val: T[&]) -> bool => IndexOf(val) != null;
    public operator in: (val: T[&]) -> bool => Contains(val);

    // Searches for the specified subspan using the given EqualityComparer and returns true if found
    public Contains: (val: T[&], equals: EqualityComparer<T>) -> bool => IndexOf(val, equals) != null;

    // Counts the number of times the specified val occurs in the span
    public Count: (in ref val: T) -> usize == {
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        if consteval {
            result: usize;
            for i in this {
                if i == val {
                    ++result;
                }
            }
            return result;
        } else {
            if version(X86 or ARM) {
                static if Builtin.IsBitwiseEquatable<T> {
                    // SIMD path
                    static if sizeof(T) == 1 {
                        return SpanHelpers.CountBytes(Span<byte>::UnsafeCreate(Unsafe.As<byte>(_data), _length), 
                            Unsafe.BitCast<byte>(val));
                    } else static if sizeof(T) == 2 {
                        return SpanHelpers.CountWords(Span<u16>::UnsafeCreate(Unsafe.As<u16>(_data), _length), 
                            Unsafe.BitCast<u16>(val));
                    } else static if sizeof(T) == 4 {
                        return SpanHelpers.CountDwords(Span<u32>::UnsafeCreate(Unsafe.As<u32>(_data), _length), 
                            Unsafe.BitCast<u32>(val));
                    } else static if sizeof(T) == 8 {
                        return SpanHelpers.CountQwords(Span<u64>::UnsafeCreate(Unsafe.As<u64>(_data), _length), 
                            Unsafe.BitCast<u64>(val));
                    }
                } else {
                    // Regular path
                    return SpanHelpers.CountGeneralCase(this, val);
                }
            } else {
                return SpanHelpers.CountGeneralCase(this, val);
            }
        }
    }

    // Counts the number of times the specified val occurs in the span using the given EqualityComparer
    public Count: (in ref val: T, equals: EqualityComparer<T>) -> usize {
        count: usize;
        for i in this {
            if equals(i, val) {
                ++count;
            }
        }
        return count;
    }

    // Counts the number of times the specified val occurs in the span
    public Count: (val: T[&]) -> usize == {
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        switch val.Length {
            0u => return 0u;
            1u => return Count(val[@Unchecked 0]);
            _ => {
                count: usize;
                span := this;
                pos := span.IndexOf(val);
                while pos {
                    span = span[(pos! + val.Length)..];
                    pos = span.IndexOf(val);
                    ++count;
                }
                return count;
            }
        }
    }

    // Counts the number of times the specified val occurs in the span using the given EqualityComparer
    public Count: (val: T[&], equals: EqualityComparer<T>) -> usize {
        switch val.Length {
            0u => return 0u;
            1u => return Count(val[@Unchecked 0], equals);
            _ => {
                count: usize;
                span := this;
                pos := span.IndexOf(val, equals);
                while pos {
                    span = span[(pos! + val.Length)..];
                    pos = span.IndexOf(val, equals);
                    ++count;
                }
                return count;
            }
        }
    }

    // Returns true if the both sequences are equal
    public SequenceEquals: (other: T[&]) -> bool == {
        static assert(type T is ISelfEquatable, "SequenceEquals available only for ISelfEquatable types");
        if (this == other)
            return true;
        if (_length != other._length)
            return false;
        if consteval {
            for i in .._length {
                if this[@Unchecked i] != other[@Unchecked i] {
                    return false;
                }
            }
            return true;
        } else {
            if version(X86 or ARM) {
                static if Builtin.IsBitwiseEquatable<T> {
                    // SIMD path
                    static if sizeof(T) == 1 {
                        return SpanHelpers.SequenceEqualsByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(_data), _length), 
                            Span<byte>::UnsafeCreate(Unsafe.As<byte>(other._data), other._length));
                    } else static if sizeof(T) == 2 {
                        return SpanHelpers.SequenceEqualsWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(_data), _length), 
                            Span<u16>::UnsafeCreate(Unsafe.As<u16>(other._data), other._length));
                    } else static if sizeof(T) == 4 {
                        return SpanHelpers.SequenceEqualsDword(Span<u32>::UnsafeCreate(Unsafe.As<u32>(_data), _length), 
                            Span<u32>::UnsafeCreate(Unsafe.As<u32>(other._data), other._length));
                    } else static if sizeof(T) == 8 {
                        return SpanHelpers.SequenceEqualsQword(Span<u64>::UnsafeCreate(Unsafe.As<u64>(_data), _length), 
                            Span<u64>::UnsafeCreate(Unsafe.As<u64>(other._data), other._length));
                    }
                } else {
                    // Regular path
                    return SpanHelpers.SequenceEqualsGeneralCase(this, other);
                }
            } else {
                return SpanHelpers.SequenceEqualsGeneralCase(this, other);
            }
        }
    }

    // Returns true if the both sequences are equal
    public SequenceEquals: (other: T[&], equals: EqualityComparer<T>) -> bool {
        if (this == other)
            return true;
        if (_length != other._length)
            return false;

        for i in .._length {
            if not equals(this[@Unchecked i], other[@Unchecked i]) {
                return false;
            }
        }

        return true;
    }
    public operator==*: (other: T[&]) -> bool ==> SequenceEquals(other);
}

public extension <T> Span {
    Length: usize ==> this.GetLength();
    IsEmpty: bool ==> this.GetLength() == 0u;

    AsBytes: Span<byte> ==
    {
        unsafe {
            return Span<byte>(UnsafePointerCast<byte>(this.GetDataReference()&), this.Length * sizeof(T));
        }
    }
    
    AsSpan: () -> Span<T> ==> this;
}

public ref struct <T> MutableSpan: ISelfEquatable, IAbstractSequence, ISequence<T> {
    public type ElementType = T;
    public type SpanType = Span<T>;
    public type MutableSpanType = self;
    public type ImmutableType = Span<T>;

    private _data: &mut T;
    private _length: usize;

    public unsafe this(ptr: *T, length: usize) == {
        this._data = ptr*;
        this._length = length;

        if ptr == null {
            throw Builtin.InvalidArgumentException();
        }
    }

    private this(ref data: T, length: usize) noexcept == {
        this._data = data;
        this._length = length;
    }

    public implicit this<S: usize>(arr: &mut T[S]) noexcept == {
        this._data = arr.GetDataReference();
        this._length = S;
    }

    public this[index: i32] -> &mut T == {
        let realIndex := index as usize;
        if realIndex >= _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return Unsafe.Add(_data, realIndex);
    }
    @Unchecked
    public this[index: i32] -> &mut T == {
        return Unsafe.Add(_data, index as usize);
    }
    public this[index: Index] -> &mut T == {
        let realIndex := index.Offset(_length) as usize;

        if realIndex >= _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return Unsafe.Add(_data, realIndex);
    }
    @Unchecked
    public this[index: Index] -> &mut T == {
        return Unsafe.Add(_data, index.Offset(_length) as usize);
    }
    Get: (index: usize) -> T? == {
        if index >= _length {
            return null;
        }
        return Unsafe.Add(_data, index);
    }
    public this[range: IndexRange] -> self == {
        let start := range.Start.Offset(_length) as usize;
        let len := range.Length(_length);

        if start >= _length or (start + len) > _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return self(Unsafe.Add(_data, start), len);
    }
    @Unchecked
    public this[range: IndexRange] -> self == {
        return self(Unsafe.Add(_data, range.Start.Offset(_length) as usize), range.Length(_length));
    }

    public Slice: (start: usize) -> self == {
        if start >= _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return self(Unsafe.Add(_data, start), _length - start);
    }

    public Slice: (start: usize, length: usize) -> self == {
        if start + length >= _length {
            throw Builtin.IndexOutOfRangeException();
        }
        return self(Unsafe.Add(_data, start), length);
    }
    public SliceUnchecked: (start: usize) -> self == {
        return self(Unsafe.Add(_data, start), _length - start);
    }

    public SliceUnchecked: (start: usize, length: usize) -> self == {
        return self(Unsafe.Add(_data, start), length);
    }

    public operator==: (other: self) -> bool noexcept == {
        return _length == other._length and Unsafe.AreSame(_data, other._data);
    }

    public GetLength: () -> usize noexcept ==> _length;
    public GetDataReference: () -> &mut T noexcept ==> _data;

    public ref struct Iterator: IAbstractIterator, IIterator<T>, IAbstractRefIterator, IRefIterator<T> {
        public type ElementType = T;

        private _ref: &mut T;
        private _length: usize;
        private _index: usize;
        friend MutableSpan<T>;

        private this(span: MutableSpan<T>) noexcept == {
            this._ref = span.GetDataReference();
            this._length = span.Length;
            this._index = usize.MaxValue;
        }

        public mut MoveNext: () -> bool noexcept == {
            let newIndex := _index +% 1uz;
            if newIndex < _length {
                _index = newIndex;
                return true;
            }
            return false;
        }
        
        public mut Reset: () noexcept == {
            _index = usize.MaxValue;
        }

        public GetCurrent: () -> T == {
            return Unsafe.Add(_ref, _index);
        }

        public GetCurrentRef: () -> ref T == {
            return Unsafe.Add(_ref, _index);
        }
    }
    public Iterate: () -> Iterator ==> Iterator(this);
    
    public static UnsafeCreate: (ref data: T, length: usize) -> self == {
        return self(&data, length);
    }

    // Searches for the specified value and returns true if found
    public Contains: (in ref val: T) -> bool == {
        return this.AsSpan().>Contains(val);
    }

    public operator in: (in ref val: T) -> bool ==> Contains(val);

    // Searches for the specified value using the given EqualityComparer and returns true if found
    public Contains: (in ref val: T, equals: EqualityComparer<T>) -> bool {
        return this.AsSpan().>Contains(val, equals);
    }

    // Searches for the specified subspan and returns true if found
    public Contains: (val: T[&]) -> bool {
        return this.AsSpan().>Contains(val);
    }
    public operator in: (val: T[&]) -> bool => Contains(val);

    // Searches for the specified subspan using the given EqualityComparer and returns true if found
    public Contains: (val: T[&], equals: EqualityComparer<T>) -> bool {
        return this.AsSpan().>Contains(val, equals);
    }

    // Counts the number of times the specified val occurs in the span
    public Count: (in ref val: T) -> usize == {
        return this.AsSpan().>Count(val);
    }

    // Counts the number of times the specified val occurs in the span using the given EqualityComparer
    public Count: (in ref val: T, equals: EqualityComparer<T>) -> usize {
        return this.AsSpan().>Count(val, equals);
    }

    // Counts the number of times the specified val occurs in the span
    public Count: (val: T[&]) -> usize == {
        return this.AsSpan().>Count(val);
    }

    // Counts the number of times the specified val occurs in the span using the given EqualityComparer
    public Count: (val: T[&], equals: EqualityComparer<T>) -> usize {
        return this.AsSpan().>Count(val, equals);
    }

    // Returns true if the both sequences are equal
    public SequenceEquals: (other: T[&]) -> bool == {
        return this.AsSpan().>SequenceEquals(other);
    }

    // Returns true if the both sequences are equal
    public SequenceEquals: (other: T[&], equals: EqualityComparer<T>) -> bool {
        return this.AsSpan().>SequenceEquals(other, equals);
    }
    public operator==*: (other: T[&]) -> bool ==> SequenceEquals(other);
}

public extension <T> MutableSpan {
    Length: usize ==> this.GetLength();
    IsEmpty: bool ==> this.GetLength() == 0u;

    AsBytes: MutableSpan<byte> ==
    {
        unsafe {
            return MutableSpan<byte>(UnsafePointerCast<byte>(this.GetDataReference()&), this.Length * sizeof(T));
        }
    }
    AsSpan: () -> Span<T> ==> this;
    AsMutableSpan: () -> MutableSpan<T> ==> this;
}

public interface ISpanConvertible {
    type SpanType;
}
public interface IMutableSpanConvertible: ISpanConvertible {
    type MutableSpanType;
}

// General Array algorithms API
public extension <TLeft> where type TLeft is ISpanConvertible {
    // Copies data to the destination span
    // Throws InvalidArgumentException if the destination span is not large enough to contain all elements
    CopyTo: <TDest> (forward dest: TDest) {
        type TLeftReal = decay(TLeft);
        type TDestReal = decay(TDest);
        type T = TLeftReal.ElementType;
        static assert(type TDestReal is IMutableSpanConvertible, "TDest should be mutable array-like type");
        static assert(type T == TDestReal.ElementType, "ElementType mismatch");
        let src: T[&] = this;
        let dst: T[&mut] = dest;
        if src.Length > dst.Length {
            throw Builtin.InvalidArgumentException();
        }

        static if Builtin.IsTriviallyCopyable<T> {
            Unsafe.CopyBlock(dst.GetDataReference(), src.GetDataReference(), src.Length * sizeof(T));
        } else {
            for i in ..src.Length {
                dst[@Unchecked i] = src[@Unchecked i];
            }
        }
    }

    // Moves data to the destination span
    // Throws InvalidArgumentException if the destination span is not large enough to contain all elements
    MoveTo: <TDest> (forward dest: TDest) {
        type TLeftReal = decay(TLeft);
        type TDestReal = decay(TDest);
        type T = TLeftReal.ElementType;
        static assert(type TDestReal is IMutableSpanConvertible, "TDest should be mutable array-like type");
        static assert(type T == TDestReal.ElementType, "ElementType mismatch");
        let src: T[&] = this;
        let dst: T[&mut] = dest;
        if src.Length > dst.Length {
            throw Builtin.InvalidArgumentException();
        }

        static if Builtin.IsTriviallyCopyable<T> {
            Unsafe.CopyBlock(dst.GetDataReference(), src.GetDataReference(), src.Length * sizeof(T));
        } else {
            for i in ..src.Length {
                dst[@Unchecked i] = move (src[@Unchecked i]);
            }
        }
    }
    // Searches an entire sorted span for a value using the default comparator
    // Returns the index of the value if found, otherwise returns the index where the value should be inserted
    // (next element that is larger than val if such element exists or length of the span otherwise)
    BinarySearch: <TValue> (forward val: TValue) -> Result<usize, usize> {
        type TLeftReal = decay(TLeft);
        type T = TLeftReal.ElementType;
        static assert(type T is ISelfComparable, 
            "Binary search available only for comparable types. Use overload with custom comparator instead.");
        return this.BinarySearch(forward val, DefaultComparator);
    }
    // Searches an entire sorted span for a value using the specified comparator
    // Returns the index of the value if found, otherwise returns the index where the value should be inserted
    // (next element that is larger than val if such element exists or length of the span otherwise)
    BinarySearch: <TValue, TComparer> (forward val: TValue, compare: TComparer) -> Result<usize, usize> {
        type TResult = Result<usize, usize>;
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type TComparerReal = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type TValueReal is operator T, "ElementType mismatch");
        static assert(type TComparerReal is operator Comparator<T>, "TComparer should be Comparator<T>");
        let span: T[&] = this;
        let length := span.Length;
        if length == 0 {
            return TResult::Err(0u);
        }

        lo: usize;
        hi := length - 1;

        while lo <= hi {
            let index := (hi + lo) >> 1;
            let cmp: i32 = compare(forward val, span[@Unchecked index]);
            switch cmp {
                0 => return index;
                >0 => lo = index + 1;
                _ => hi = index - 1;
            }
        }

        return TResult::Err(lo);
    }

    // Finds the length of any common prefix shared between this and the other span
    // Returns index of the first mismatched element
    // Returns 0 if there is no shared prefix
    // Returns null if both sequences are equal including its length
    Mismatch: <TRight> (forward otherArray: TRight) -> usize?
    {
        type TLeftReal = decay(TLeft);
        type TRightReal = decay(TRight);
        type T = TLeftReal.ElementType;
        static assert(type TRightReal is ISpanConvertible, "TRight should be array-like type");
        static assert(type T == TRightReal.ElementType, "ElementType mismatch");
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        let spanLeft: T[&] = this;
        let spanRight: T[&] = otherArray;
        let isSameLength := spanLeft.Length == spanRight.Length;
        let length := spanLeft.Length.Min(spanRight.Length);
        const simdSupported :== version(X86) or version(ARM);
        static if simdSupported and Builtin.IsBitwiseEquatable<T> {
            // SIMD path
            const size :== sizeof(T);
            let index := SpanHelpers.Mismatch(spanLeft.AsBytes, spanRight.AsBytes, length * size) \ size;
            if index < length or not isSameLength {
                return index;
            }
        } else {
            // Regular path
            for i in ..length {
                if spanLeft[@Unchecked i] != spanRight[@Unchecked i] {
                    return i;
                }
            }
            if not isSameLength {
                return length;
            }
        }
        return null;
    }

    // Finds the length of any common prefix shared between this and the other span using the given EqualityComparer
    // Returns index of the first mismatched element
    // Returns 0 if there is no shared prefix
    // Returns null if both sequences are equal including its length
    Mismatch: <TRight, TComparer> (otherArray: TRight, equals: TComparer) -> usize? {
        type TLeftReal = decay(TLeft);
        type TRightReal = decay(TRight);
        type TComparerReal = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type TRightReal is ISpanConvertible, "TRight should be array-like type");
        static assert(type T == TRightReal.ElementType, "ElementType mismatch");
        static assert(type TComparerReal is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        let spanLeft: T[&] = this;
        let spanRight: T[&] = otherArray;
        let isSameLength := spanLeft.Length == spanRight.Length;
        let length := spanLeft.Length.Min(spanRight.Length);
        for i in ..length {
            if not equals(spanLeft[@Unchecked i], spanRight[@Unchecked i]) {
                return i;
            }
        }
        if not isSameLength {
            return length;
        }
        return null;
    }

    // Searches for the specified value and returns the index of its first occurrence. If not found, returns null.
    IndexOf: <TValue> (forward val: TValue) -> usize? == {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type T = TLeftReal.ElementType;
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            valSpan: T[&] = val;
            const simdSupported :== version(X86) or version(ARM);
            static if simdSupported and Builtin.IsBitwiseEquatable<T> {
                static if sizeof(T) == 1 {
                    return SpanHelpers.IndexOfInternal(span.AsBytes, valSpan.AsBytes);
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.IndexOfInternal(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span.GetDataReference()), span.Length), 
                        Span<u16>::UnsafeCreate(Unsafe.As<u16>(valSpan.GetDataReference()), valSpan.Length));
                }
            }
            return SpanHelpers.IndexOfInternal(span, valSpan);
        } else static if type TValueReal is operator T {
            if consteval {
                index: usize;
                for i in span {
                    if i == val {
                        return index;
                    }
                    ++index;
                }
                return null;
            } else {
                if version(X86 or ARM) {
                    static if Builtin.IsBitwiseEquatable<T> {
                        // SIMD path
                        static if sizeof(T) == 1 {
                            return SpanHelpers.IndexOfByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(val));
                        } else static if sizeof(T) == 2 {
                            return SpanHelpers.IndexOfWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(val));
                        } else static if sizeof(T) == 4 {
                            return SpanHelpers.IndexOfDword(Span<u32>::UnsafeCreate(Unsafe.As<u32>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u32>(val));
                        } else static if sizeof(T) == 8 {
                            return SpanHelpers.IndexOfQword(Span<u64>::UnsafeCreate(Unsafe.As<u64>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u64>(val));
                        }
                    } else {
                        // Regular path
                        return SpanHelpers.IndexOfGeneralCase(span, val);
                    }
                } else {
                    return SpanHelpers.IndexOfGeneralCase(span, val);
                }
            }
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
    }

    // Searches for the specified value and returns the index of its first occurrence using the given EqualityComparer.
    // If not found, returns null.
    IndexOf: <TValue, TComparer> (forward val: TValue, equals: TComparer) -> usize? {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type TComparerReal = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type TComparerReal is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            let valSpan: T[&] = val;
            if valSpan.Length == 0u {
                return 0u;
            }

            totalIndex: usize;
            while not span.IsEmpty {
                if let pos := span.IndexOf(valSpan[@Unchecked 0], equals) {
                    span = span[@Unchecked (pos + 1u)..];
                    if span.StartsWith(valSpan[@Unchecked 1u..], equals) {
                        return totalIndex + pos;
                    }
                    totalIndex += pos + 1u;
                } else {
                    break;
                }
            }
        } else static if type TValueReal is operator T {
            let length := span.Length;
            for i in ..length {
                if equals(span[@Unchecked i], val) {
                    return i;
                }
            }
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
        
        return null;
    }

    // Searches for the first index of any of the specified values from span.
    // If not found, returns null.
    IndexOfAny: <TValues> (forward val: TValues) -> usize? {
        type TLeftReal = decay(TLeft);
        type TValuesReal = decay(TValues);
        type T = TLeftReal.ElementType;
        let span: T[&] = this;
        static if type TValuesReal is ISpanConvertible {
            static assert(type T == TValuesReal.ElementType, "ElementType mismatch");
            static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
            let values: T[&] = val;
            let valuesLength := values.Length;
            const simdSupported :== version(X86) or version(ARM);
            static if simdSupported and Builtin.IsBitwiseEquatable<T> {
                static if sizeof(T) == 1 {
                    return switch valuesLength -> usize? {
                        0 => null,
                        1 => SpanHelpers.IndexOfByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(values[@Unchecked 0])),
                        2 => SpanHelpers.IndexOfAnyByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(values[@Unchecked 0]), Unsafe.BitCast<byte>(values[@Unchecked 1])),
                        3 => SpanHelpers.IndexOfAnyByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(values[@Unchecked 0]), Unsafe.BitCast<byte>(values[@Unchecked 1]),
                                Unsafe.BitCast<byte>(values[@Unchecked 2])),
                        4 => SpanHelpers.IndexOfAnyByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(values[@Unchecked 0]), Unsafe.BitCast<byte>(values[@Unchecked 1]), 
                                Unsafe.BitCast<byte>(values[@Unchecked 2]), Unsafe.BitCast<byte>(values[@Unchecked 3])),
                        5 => SpanHelpers.IndexOfAnyByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(values[@Unchecked 0]), Unsafe.BitCast<byte>(values[@Unchecked 1]), 
                                Unsafe.BitCast<byte>(values[@Unchecked 2]), Unsafe.BitCast<byte>(values[@Unchecked 3]),
                                Unsafe.BitCast<byte>(values[@Unchecked 4])),
                        _ => SpanHelpers.IndexOfAnyInternal(span, values)
                    };
                } else static if sizeof(T) == 2 {
                    return switch valuesLength -> usize? {
                        0 => null,
                        1 => SpanHelpers.IndexOfWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(values[@Unchecked 0])),
                        2 => SpanHelpers.IndexOfAnyWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(values[@Unchecked 0]), Unsafe.BitCast<u16>(values[@Unchecked 1])),
                        3 => SpanHelpers.IndexOfAnyWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(values[@Unchecked 0]), Unsafe.BitCast<u16>(values[@Unchecked 1]),
                                Unsafe.BitCast<u16>(values[@Unchecked 2])),
                        4 => SpanHelpers.IndexOfAnyWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(values[@Unchecked 0]), Unsafe.BitCast<u16>(values[@Unchecked 1]), 
                                Unsafe.BitCast<u16>(values[@Unchecked 2]), Unsafe.BitCast<u16>(values[@Unchecked 3])),
                        5 => SpanHelpers.IndexOfAnyWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(values[@Unchecked 0]), Unsafe.BitCast<u16>(values[@Unchecked 1]), 
                                Unsafe.BitCast<u16>(values[@Unchecked 2]), Unsafe.BitCast<u16>(values[@Unchecked 3]),
                                Unsafe.BitCast<u16>(values[@Unchecked 4])),
                        _ => SpanHelpers.IndexOfAnyInternal(span, values)
                    };
                }
            }
            
            return SpanHelpers.IndexOfAnyInternal(span, values);
        } else static if type TValuesReal == Range<T, true> {
            static assert(type T is ISelfComparable, "Search values in range is available only for ISelfComparable types");
            const simdSupported :== version(X86) or version(ARM);
            static if simdSupported and Builtin.IsBitwiseEquatable<T> {
                // SIMD path
                static if sizeof(T) == 1 {
                    return SpanHelpers.IndexOfAnyInRangeByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<byte>(val.GetStart()), Unsafe.BitCast<byte>(val.GetEnd()));
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.IndexOfAnyInRangeWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<u16>(val.GetStart()), Unsafe.BitCast<u16>(val.GetEnd()));
                } else static if sizeof(T) == 4 {
                    return SpanHelpers.IndexOfAnyInRangeDword(Span<u32>::UnsafeCreate(Unsafe.As<u32>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<u32>(val.GetStart()), Unsafe.BitCast<u32>(val.GetEnd()));
                } else static if sizeof(T) == 8 {
                    return SpanHelpers.IndexOfAnyInRangeQword(Span<u64>::UnsafeCreate(Unsafe.As<u64>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<u64>(val.GetStart()), Unsafe.BitCast<u64>(val.GetEnd()));
                }
            } else {
                // Regular path
                return SpanHelpers.IndexOfAnyInRangeGeneralCase(span, val.Start, val.End);
            }
        } else {
            static assert(false, "val should be inclusive range or array-like type");
        }
        return null;
    }

    ContainsAny: <TValues> (forward val: TValues) -> bool => this.IndexOfAny(forward val) != null;

    // Searches for the first index of any of the specified values
    // If not found, returns null.
    IndexOfAny: <T1, T2> (forward val1: T1, forward val2: T2) -> usize? {
        type TLeftReal = decay(TLeft);
        type T1Real = decay(T1);
        type T2Real = decay(T2);
        type T = TLeftReal.ElementType;
        let span: T[&] = this;
        static if type T2Real is operator EqualityComparer<T> {
            static assert(type T1Real is ISpanConvertible, "T1 should be an array-like type");
            static assert(type T == T1Real.ElementType, "ElementType mismatch");
            let values: T[&] = val1;
            let length := span.Length;
            let valuesLength := values.Length;
            for i in ..length {
                for j in ..valuesLength {
                    if val2(span[@Unchecked i], values[@Unchecked j]) {
                        return i;
                    }
                }
            }
        } else static if type T2Real is operator T {
            static assert(type T1Real is operator T, "ElementType mismatch");
            static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
            const simdSupported :== version(X86) or version(ARM);
            static if simdSupported and Builtin.IsBitwiseEquatable<T> {
                static if sizeof(T) == 1 {
                    return SpanHelpers.IndexOfAnyByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(val1), Unsafe.BitCast<byte>(val2));
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.IndexOfAnyWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(val1), Unsafe.BitCast<u16>(val2));
                }
            }
            
            return SpanHelpers.IndexOfAnyGeneralCase(span, val1, val2);
        } else {
            static assert(false, "T1 should be ElementType or Span<ElementType>");
        }
        return null;
    }
    
    ContainsAny: <T1, T2> (forward val1: T1, forward val2: T2) -> bool => this.IndexOfAny(forward val1, forward val2) != null;

    // Searches for the first index of any of the specified values
    // If not found, returns null.
    IndexOfAny: <T1, T2, T3> (forward val1: T1, forward val2: T2, forward val3: T3) -> usize? {
        type TLeftReal = decay(TLeft);
        type T1Real = decay(T1);
        type T2Real = decay(T2);
        type T3Real = decay(T3);
        type T = TLeftReal.ElementType;
        let span: T[&] = this;
        static if type T3Real is operator EqualityComparer<T> {
            static assert(type T1Real is operator T, "ElementType mismatch");
            static assert(type T2Real is operator T, "ElementType mismatch");
            let length := span.Length;
            for i in ..length {
                let val := span[@Unchecked i];
                if val3(val, val1) or val3(val, val2) {
                    return i;
                }
            }
        } else static if type T3Real is operator T {
            static assert(type T1Real is operator T, "ElementType mismatch");
            static assert(type T2Real is operator T, "ElementType mismatch");
            static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
            const simdSupported :== version(X86) or version(ARM);
