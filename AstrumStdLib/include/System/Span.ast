    public ReplaceGeneralCase: <T> (buf: T[&mut], in ref oldValue: T, in ref newValue: T) {
        for &i in buf {
            if i == oldValue {
                i = newValue;
            }
        }
    }

    public ReplaceByte: (buf: byte[&mut], oldValue: byte, newValue: byte) {
