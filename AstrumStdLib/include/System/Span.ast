    public LastIndexOfAnyInRangeGeneralCase: <T> (data: T[&], in ref start: T, in ref end: T) -> usize? {
        length := data.Length;
        for i := isize(length) - 1; i >= 0; --i {
            let &current := data[@Unchecked i as usize];
            if current in start..=end {
                return i as usize;
            }
        }
        return null;
    }

