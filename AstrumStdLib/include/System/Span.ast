                // SIMD path
                static if sizeof(T) == 1 {
                    return SpanHelpers.IndexOfAnyExceptInRangeByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<byte>(val.GetStart()), Unsafe.BitCast<byte>(val.GetEnd()));
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.IndexOfAnyExceptInRangeWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<u16>(val.GetStart()), Unsafe.BitCast<u16>(val.GetEnd()));
                } else static if sizeof(T) == 4 {
                    return SpanHelpers.IndexOfAnyExceptInRangeDword(Span<u32>::UnsafeCreate(Unsafe.As<u32>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<u32>(val.GetStart()), Unsafe.BitCast<u32>(val.GetEnd()));
                } else static if sizeof(T) == 8 {
                    return SpanHelpers.IndexOfAnyExceptInRangeQword(Span<u64>::UnsafeCreate(Unsafe.As<u64>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<u64>(val.GetStart()), Unsafe.BitCast<u64>(val.GetEnd()));
                }
            } else {
