            const simdSupported :== version(X86) or version(ARM);
            static if simdSupported and Builtin.IsBitwiseEquatable<T> {
                static if sizeof(T) == 1 {
                    return SpanHelpers.IndexOfAnyExceptByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(val1), Unsafe.BitCast<byte>(val2),
                                Unsafe.BitCast<byte>(val3));
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.IndexOfAnyExceptWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(val1), Unsafe.BitCast<u16>(val2),
                                Unsafe.BitCast<u16>(val3));
                }
            }
            
            return SpanHelpers.IndexOfAnyExceptGeneralCase(span, val1, val2, val3);
        } else {
            static assert(false, "T1, T2, T3 should be ElementType");
        }
        return null;
    }

    ContainsAnyExcept: <T1, T2, T3> (forward val1: T1, forward val2: T2, forward val3: T3) -> bool 
        => this.IndexOfAnyExcept(forward val1, forward val2, forward val3) != null;

    // Searches for the first index of any value other than of the specified values.
    // If not found, returns null.
    IndexOfAnyExcept: <T1, T2, T3, TComparer> (forward val1: T1, forward val2: T2, forward val3: T3, equals: TComparer) -> usize? {
        type TLeftReal = decay(TLeft);
        type T1Real = decay(T1);
        type T2Real = decay(T2);
        type T3Real = decay(T3);
        type T4Real = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type T1Real is operator T, "ElementType mismatch");
        static assert(type T2Real is operator T, "ElementType mismatch");
        static assert(type T3Real is operator T, "ElementType mismatch");
        static assert(type T4Real is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        let span: T[&] = this;
        let length := span.Length;
        for i in ..length {
            let val := span[@Unchecked i];
            if (not equals(val, val1)) and (not equals(val, val2)) and (not equals(val, val3)) {
                return i;
            }
        }
        return null;
    }

    ContainsAnyExcept: <T1, T2, T3, TComparer> (forward val1: T1, forward val2: T2, forward val3: T3, equals: TComparer) -> bool 
        => this.IndexOfAnyExcept(forward val1, forward val2, forward val3, equals) != null;

    // Returns true the specified value appears at the start of the span.
    StartsWith: <TValue> (forward val: TValue) -> bool == {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type T = TLeftReal.ElementType;
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        let span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            let valSpan: T[&] = val;
            let valueLength := valSpan.Length;
            static if Builtin.IsBitwiseEquatable<T> {
                return valueLength <= span.Length and SpanHelpers.SequenceEqualsByte(span[..valueLength].AsBytes, valSpan.AsBytes);
            } else {
                return valueLength <= span.Length and span[..valueLength].SequenceEquals(valSpan);
            }
        } else static if type TValueReal is operator T { 
            return not span.IsEmpty and span[@Unchecked 0] == val;
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
    }

    // Returns true the specified value appears at the start of the span.
    StartsWith: <TValue, TComparer> (forward val: TValue, equals: TComparer) -> bool {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type TComparerReal = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type TComparerReal is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        let span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            let valSpan: T[&] = val;
            let valueLength := valSpan.Length;
            return valueLength <= span.Length and span[..valueLength].SequenceEquals(valSpan, equals);
        } else static if type TValueReal is operator T { 
            return not span.IsEmpty and equals(span[@Unchecked 0], val);
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
    }

    // Returns true the specified value appears at the end of the span.
    EndsWith: <TValue> (forward val: TValue) -> bool == {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type T = TLeftReal.ElementType;
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        let span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            let valSpan: T[&] = val;
            let valueLength := valSpan.Length;
            let spanLength := span.Length;
            static if Builtin.IsBitwiseEquatable<T> {
                return valueLength <= spanLength and SpanHelpers.SequenceEqualsByte(span[(spanLength - valueLength)..].AsBytes,
                    valSpan.AsBytes);
            } else {
                return valueLength <= spanLength and span[(spanLength - valueLength)..].SequenceEquals(valSpan);
            }
        } else static if type TValueReal is operator T { 
            return not span.IsEmpty and span[@Unchecked ^1u] == val;
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
    }

    // Returns true the specified value appears at the end of the span.
    EndsWith: <TValue, TComparer> (forward val: TValue, equals: TComparer) -> bool {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type TComparerReal = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type TComparerReal is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        let span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            let valSpan: T[&] = val;
            let valueLength := valSpan.Length;
            let spanLength := span.Length;
            return valueLength <= spanLength and span[(spanLength - valueLength)..].SequenceEquals(valSpan, equals);
        } else static if type TValueReal is operator T { 
            return not span.IsEmpty and equals(span[@Unchecked ^1u], val);
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
    }
}

protected static class SpanHelpers {
    public ContainsGeneralCase: <T> (data: T[&], in ref val: T) -> bool {
        length := data.Length;
        offset: i32;
        while length >= 8u {
            length -= 8u;

            if data[@Unchecked offset] == val or
                data[@Unchecked offset + 1] == val or
                data[@Unchecked offset + 2] == val or
                data[@Unchecked offset + 3] == val or
                data[@Unchecked offset + 4] == val or
                data[@Unchecked offset + 5] == val or
                data[@Unchecked offset + 6] == val or
                data[@Unchecked offset + 7] == val
            {
                return true;
            }

            offset += 8;
        }

        while length >= 4u {
            length -= 4u;

            if data[@Unchecked offset] == val or
                data[@Unchecked offset + 1] == val or
                data[@Unchecked offset + 2] == val or
                data[@Unchecked offset + 3] == val
            {
                return true;
            }

            offset += 4;
        }

        while length > 0 {
            --length;
            if data[@Unchecked offset] == val {
                return true;
            }
            ++offset;
        }
        return false;
    }

    public ContainsByte: (data: byte[&], val: byte) -> bool {
        let length := data.Length;
        if length < 16u {
            return ContainsGeneralCase(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanContains<byte>, Neon, Sse2>(data, val);
        } else if length < 64u {
            return Simd.RuntimeDispatch<SpanContains<byte>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanContains<byte>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public ContainsWord: (data: u16[&], val: u16) -> bool {
        let length := data.Length;
        if length < 8u {
            return ContainsGeneralCase(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanContains<u16>, Neon, Sse2>(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanContains<u16>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanContains<u16>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public ContainsDword: (data: u32[&], val: u32) -> bool {
        let length := data.Length;
        if length < 4u {
            return ContainsGeneralCase(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanContains<u32>, Neon, Avx512VL128, Sse2>(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanContains<u32>, Neon, Avx512VL256, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanContains<u32>, Neon, Avx512F, Avx2, Sse2>(data, val);
        }
    }

    public ContainsQword: (data: u64[&], val: u64) -> bool {
        let length := data.Length;
        if length < 2u {
            return ContainsGeneralCase(data, val);
        } else if length < 4u {
            return Simd.RuntimeDispatch<SpanContains<u64>, Neon, Avx512VL128, Sse42, Sse2>(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanContains<u64>, Neon, Avx512VL256, Avx2, Sse42, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanContains<u64>, Neon, Avx512F, Avx2, Sse42, Sse2>(data, val);
        }
    }

    public CountGeneralCase: <T> (data: T[&], val: T) -> usize {
        count: usize;
        for i in data {
            if i == val {
                ++count;
            }
        }
        return count;
    }

    public CountBytes: (data: byte[&], val: byte) -> usize {
        let length := data.Length;
        if length < 16u {
            return CountGeneralCase(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanCount<byte>, Neon, Sse2>(data, val);
        } else if length < 64u {
            return Simd.RuntimeDispatch<SpanCount<byte>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanCount<byte>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public CountWords: (data: u16[&], val: u16) -> usize {
        let length := data.Length;
        if length < 8u {
            return CountGeneralCase(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanCount<u16>, Neon, Sse2>(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanCount<u16>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanCount<u16>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public CountDwords: (data: u32[&], val: u32) -> usize {
        let length := data.Length;
        if length < 4u {
            return CountGeneralCase(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanCount<u32>, Neon, Avx512VL128, Sse2>(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanCount<u32>, Neon, Avx512VL256, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanCount<u32>, Neon, Avx512F, Avx2, Sse2>(data, val);
        }
    }

    public CountQwords: (data: u64[&], val: u64) -> usize {
        let length := data.Length;
        if length < 2u {
            return CountGeneralCase(data, val);
        } else if length < 4u {
            return Simd.RuntimeDispatch<SpanCount<u64>, Neon, Avx512VL128, Sse42, Sse2>(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanCount<u64>, Neon, Avx512VL256, Avx2, Sse42, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanCount<u64>, Neon, Avx512F, Avx2, Sse42, Sse2>(data, val);
        }
    }

    public Mismatch: (left: byte[&], right: byte[&], length: usize) -> usize {
        //assert left.Length <= length and right.Length <= length;
        index: usize;

        if length < 16u {
            index = length % 4u;
            if index {
                if left[@Unchecked 0] != right[@Unchecked 0] {
                    return 0u;
                }

                if index > 1u {
                    if left[@Unchecked 1] != right[@Unchecked 1] {
                        return 1u;
                    }

                    if index > 2u and left[@Unchecked 2] != right[@Unchecked 2] {
                        return 2u;
                    }
                }
            }

            while index <= length - 4u {
                if left[@Unchecked index] != right[@Unchecked index] {
                    return index;
                }
                if left[@Unchecked index + 1u] != right[@Unchecked index + 1u] {
                    return index + 1u;
                }
                if left[@Unchecked index + 2u] != right[@Unchecked index + 2u] {
                    return index + 2u;
                }
                if left[@Unchecked index + 3u] != right[@Unchecked index + 3u] {
                    return index + 3u;
                }

                index += 4u;
            }
            return length;
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanMismatch, Neon, Sse2>(left, right, length);
        } else if length < 64u {
            return Simd.RuntimeDispatch<SpanMismatch, Neon, Avx2, Sse2>(left, right, length);
        } else {
            return Simd.RuntimeDispatch<SpanMismatch, Neon, Avx512BW, Avx2, Sse2>(left, right, length);
        }
    }

    public IndexOfGeneralCase: <T> (data: T[&], in ref val: T) -> usize? {
        length := data.Length;
        index: usize;
        while length >= 8u {
            length -= 8u;

            if data[@Unchecked index] == val
            {
                return index;
            }
            if data[@Unchecked index + 1u] == val
            {
                return index + 1u;
            }
            if data[@Unchecked index + 2u] == val
            {
                return index + 2u;
            }
            if data[@Unchecked index + 3u] == val
            {
                return index + 3u;
            }
            if data[@Unchecked index + 4u] == val
            {
                return index + 4u;
            }
            if data[@Unchecked index + 5u] == val
            {
                return index + 5u;
            }
            if data[@Unchecked index + 6u] == val
            {
                return index + 6u;
            }
            if data[@Unchecked index + 7u] == val
            {
                return index + 7u;
            }

            index += 8;
        }

        while length >= 4u {
            length -= 4u;

            if data[@Unchecked index] == val
            {
                return index;
            }
            if data[@Unchecked index + 1u] == val
            {
                return index + 1u;
            }
            if data[@Unchecked index + 2u] == val
            {
                return index + 2u;
            }
            if data[@Unchecked index + 3u] == val
            {
                return index + 3u;
            }

            index += 4;
        }

        while length > 0 {
            --length;
            if data[@Unchecked index] == val {
                return index;
            }
            ++index;
        }
        return null;
    }

    public IndexOfByte: (data: byte[&], val: byte) -> usize? {
        let length := data.Length;
        if length < 16u {
            return IndexOfGeneralCase(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanIndexOf<byte>, Neon, Sse2>(data, val);
        } else if length < 64u {
            return Simd.RuntimeDispatch<SpanIndexOf<byte>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanIndexOf<byte>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public IndexOfWord: (data: u16[&], val: u16) -> usize? {
        let length := data.Length;
        if length < 8u {
            return IndexOfGeneralCase(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanIndexOf<u16>, Neon, Sse2>(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanIndexOf<u16>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanIndexOf<u16>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public IndexOfDword: (data: u32[&], val: u32) -> usize? {
        let length := data.Length;
        if length < 4u {
            return IndexOfGeneralCase(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanIndexOf<u32>, Neon, Avx512VL128, Sse2>(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanIndexOf<u32>, Neon, Avx512VL256, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanIndexOf<u32>, Neon, Avx512F, Avx2, Sse2>(data, val);
        }
    }

    public IndexOfQword: (data: u64[&], val: u64) -> usize? {
        let length := data.Length;
        if length < 2u {
            return IndexOfGeneralCase(data, val);
        } else if length < 4u {
            return Simd.RuntimeDispatch<SpanIndexOf<u64>, Neon, Avx512VL128, Sse42, Sse2>(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanIndexOf<u64>, Neon, Avx512VL256, Avx2, Sse42, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanIndexOf<u64>, Neon, Avx512F, Avx2, Sse42, Sse2>(data, val);
        }
    }

    public IndexOfInternal: <T> (data: T[&], val: T[&]) -> usize? {
        let dataLength := data.Length;
        let valueLength := val.Length;
        if valueLength == 0 {
            return 0u;
        }

        let valueHead := val[@Unchecked 0];
        let valueTail := val[@Unchecked 1u..];
        let valueTailLength := valueLength - 1u;
        index: usize;

        for {
            assert index <= dataLength;
            let remainingLength := dataLength -% index -% valueTailLength;
            if remainingLength.NarrowToIsize() <= 0 {
                break;
            }

            if let relativeIndex := data.SliceUnchecked(index, remainingLength).IndexOf(valueHead) {
                index += relativeIndex;
            } else {
                break;
            }

            if data.SliceUnchecked(index + 1u, valueTailLength).SequenceEquals(valueTail) {
                return index;
            }
            ++index;
        }
        return null;
    }

    public IndexOfAnyInternal: <T> (data: T[&], val: T[&]) -> usize? {
        let dataLength := data.Length;
        let valueLength := val.Length;
        if valueLength == 0 {
            return null;
        }

        for i in ..dataLength {
            let candidate := data[@Unchecked i];
            for j in ..valueLength {
                if candidate == val[@Unchecked j] {
                    return i;
                }
            }
        }
        return null;
    }

    public IndexOfAnyGeneralCase: <T> (data: T[&], in ref val1: T, in ref val2: T) -> usize? {
        length := data.Length;
        index: usize;
        while length >= 8u {
            length -= 8u;

            lookup := data[@Unchecked index];
            if lookup == val1 or lookup == val2
            {
                return index;
            }
            lookup = data[@Unchecked index + 1u];
            if lookup == val1 or lookup == val2
            {
                return index + 1u;
            }
            lookup = data[@Unchecked index + 2u];
            if lookup == val1 or lookup == val2
            {
                return index + 2u;
            }
            lookup = data[@Unchecked index + 3u];
            if lookup == val1 or lookup == val2
            {
                return index + 3u;
            }
            lookup = data[@Unchecked index + 4u];
            if lookup == val1 or lookup == val2
            {
                return index + 4u;
            }
            lookup = data[@Unchecked index + 5u];
            if lookup == val1 or lookup == val2
            {
                return index + 5u;
            }
            lookup = data[@Unchecked index + 6u];
            if lookup == val1 or lookup == val2
            {
                return index + 6u;
            }
            lookup = data[@Unchecked index + 7u];
            if lookup == val1 or lookup == val2
            {
                return index + 7u;
            }

            index += 8;
        }

        while length >= 4u {
            length -= 4u;

            lookup := data[@Unchecked index];
            if lookup == val1 or lookup == val2
            {
                return index;
            }
            lookup = data[@Unchecked index + 1u];
            if lookup == val1 or lookup == val2
            {
                return index + 1u;
            }
            lookup = data[@Unchecked index + 2u];
            if lookup == val1 or lookup == val2
            {
                return index + 2u;
            }
            lookup = data[@Unchecked index + 3u];
            if lookup == val1 or lookup == val2
            {
                return index + 3u;
            }

            index += 4;
        }

        while length > 0 {
            --length;
            lookup := data[@Unchecked index];
            if lookup == val1 or lookup == val2 {
                return index;
            }
            ++index;
        }
        return null;
    }

    public IndexOfAnyGeneralCase: <T> (data: T[&], in ref val1: T, in ref val2: T, in ref val3: T) -> usize? {
        length := data.Length;
        index: usize;
        while length >= 8u {
            length -= 8u;

            lookup := data[@Unchecked index];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index;
            }
            lookup = data[@Unchecked index + 1u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 1u;
            }
            lookup = data[@Unchecked index + 2u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 2u;
            }
            lookup = data[@Unchecked index + 3u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 3u;
            }
            lookup = data[@Unchecked index + 4u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 4u;
            }
            lookup = data[@Unchecked index + 5u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 5u;
            }
            lookup = data[@Unchecked index + 6u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 6u;
            }
            lookup = data[@Unchecked index + 7u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 7u;
            }

            index += 8;
        }

        while length >= 4u {
            length -= 4u;

            lookup := data[@Unchecked index];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index;
            }
            lookup = data[@Unchecked index + 1u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 1u;
            }
            lookup = data[@Unchecked index + 2u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 2u;
            }
            lookup = data[@Unchecked index + 3u];
            if lookup == val1 or lookup == val2 or lookup == val3
            {
                return index + 3u;
            }

            index += 4;
        }

        while length > 0 {
            --length;
            lookup := data[@Unchecked index];
            if lookup == val1 or lookup == val2 or lookup == val3 {
                return index;
            }
            ++index;
        }
        return null;
    }

    public IndexOfAnyInRangeGeneralCase: <T> (data: T[&], in ref start: T, in ref end: T) -> usize? {
        length := data.Length;
        index: usize;
        for i in ..length {
            let &current := data[@Unchecked i];
            if current in start..=end {
                return i;
            }
        }
        return null;
    }

    public IndexOfAnyByte: (data: byte[&], val1: byte, val2: byte) -> usize? {
        let length := data.Length;
        if length < 16u {
            return IndexOfAnyGeneralCase(data, val1, val2);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanIndexOfAny2<byte>, Neon, Sse2>(data, val1, val2);
        } else if length < 64u {
            return Simd.RuntimeDispatch<SpanIndexOfAny2<byte>, Neon, Avx2, Sse2>(data, val1, val2);
        } else {
            return Simd.RuntimeDispatch<SpanIndexOfAny2<byte>, Neon, Avx512BW, Avx2, Sse2>(data, val1, val2);
        }
    }

    public IndexOfAnyByte: (data: byte[&], val1: byte, val2: byte, val3: byte) -> usize? {
        let length := data.Length;
        if length < 16u {
            return IndexOfAnyGeneralCase(data, val1, val2, val3);
        } else if length < 32u {
