    ContainsAnyExcept: <T1> (forward val: T1) -> bool 
        => this.IndexOfAnyExcept(forward val) != null;

    // Searches for the first index of any value other than of the specified values.
    // If not found, returns null.
    IndexOfAnyExcept: <T1, T2> (forward val1: T1, forward val2: T2) -> usize? {
        type TLeftReal = decay(TLeft);
        type T1Real = decay(T1);
        type T2Real = decay(T2);
        type T = TLeftReal.ElementType;
        let span: T[&] = this;
        static if type T2Real is operator EqualityComparer<T> {
            static if type T1Real is ISpanConvertible {
                static assert(type T == T1Real.ElementType, "ElementType mismatch");
                let values: T[&] = val1;
                let length := span.Length;
                let valuesLength := values.Length;
                outer:
                for i in ..length {
                    for j in ..valuesLength {
                        if val2(span[@Unchecked i], values[@Unchecked j]) {
                            continue outer;
                        }
                    }
                    return i;
                }
            } else static if type T1Real is operator T {
                let length := span.Length;
                for i in ..length {
                    if not val2(span[@Unchecked i], val1) {
                        return i;
                    }
                }
