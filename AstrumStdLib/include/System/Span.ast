        }
    }
}

private static class <T> SpanContains {
    public Invoke: <Arch> (data: T[&], val: T) -> bool {
        type TVector = SimdVector<T, Arch>;
        const vecSize :== TVector::Length;
        let count := data.Length;
        let vecLast := count - vecSize;
        let values := TVector::Create(val);
        current: TVector;
        for i := 0u; i <= vecLast; i += vecSize {
            current = TVector::LoadUnsafe(data[@Unchecked i]);
            if current.EqualsAny(values) {
                return true;
            }
        }
        if not count.IsMultipleOf(vecSize) {
            current = TVector::LoadUnsafe(data[@Unchecked vecLast]);
            if current.EqualsAny(values) {
                return true;
            }
        }
        return false;
    }
}

private static class SpanMismatch {
    public Invoke: <Arch> (left: byte[&], right: byte[&], length: usize) -> usize {
        type TVector = SimdVector<byte, Arch>;
        type TMask = SimdMask<byte, Arch>;
        const vecSize :== TVector::Length;
        let vecLast := length - vecSize;
        index: usize;
        maskVec: TMask;
        while index < vecLast {
            maskVec = TVector::LoadUnsafe(left[@Unchecked index]) !=^ TVector::LoadUnsafe(right[@Unchecked index]);
            if let i := maskVec.FirstSet {
                return index + i;
            }
            index += vecSize;
        }
        index = vecLast;
        maskVec = TVector::LoadUnsafe(left[@Unchecked index]) !=^ TVector::LoadUnsafe(right[@Unchecked index]);
        if let i := maskVec.FirstSet {
            return index + i;
        }
        return length;
    }
}

private static class <T> SpanCount {
    public Invoke: <Arch> (data: T[&], val: T) -> usize {
        type TVector = SimdVector<T, Arch>;
        type TMask = SimdMask<T, Arch>;
        const vecSize :== TVector::Length;
        let length := data.Length;
        let vecLast := length - vecSize;
        let values := TVector::Create(val);
        currentVec: TVector;
        currentMask: TMask;
        count: usize;
        i: usize;
        for ; i < vecLast; i += vecSize {
            currentVec = TVector::LoadUnsafe(data[@Unchecked i]);
            currentMask = currentVec ==^ values;
            count += currentMask.Count;
        }
        mask := (TVector::LoadUnsafe(data[@Unchecked vecLast]) ==^ values).ScalarMask;
        if i > vecLast {
            //mask <<= 64u - vecSize + (i - vecLast);
            mask >>= i - vecLast;
        }
        count += mask.PopCount;
        return count;
    }
}

