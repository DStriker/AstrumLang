                        Unsafe.BitCast<byte>(val.GetStart()), Unsafe.BitCast<byte>(val.GetEnd()));
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.LastIndexOfAnyExceptInRangeWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<u16>(val.GetStart()), Unsafe.BitCast<u16>(val.GetEnd()));
                } else static if sizeof(T) == 4 {
                    return SpanHelpers.LastIndexOfAnyExceptInRangeDword(Span<u32>::UnsafeCreate(Unsafe.As<u32>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<u32>(val.GetStart()), Unsafe.BitCast<u32>(val.GetEnd()));
                } else static if sizeof(T) == 8 {
                    return SpanHelpers.LastIndexOfAnyExceptInRangeQword(Span<u64>::UnsafeCreate(Unsafe.As<u64>(span[@Unchecked 0]), span.Length), 
                        Unsafe.BitCast<u64>(val.GetStart()), Unsafe.BitCast<u64>(val.GetEnd()));
                }
            } else {
                // Regular path
                return SpanHelpers.LastIndexOfAnyExceptInRangeGeneralCase(span, val.Start, val.End);
            }
        } else {
            static assert(false, "val should be ElementType or array-like type");
        }
        return null;
    }

    // Searches for the last index of any value other than of the specified values.
    // If not found, returns null.
    LastIndexOfAnyExcept: <T1, T2> (forward val1: T1, forward val2: T2) -> usize? {
        type TLeftReal = decay(TLeft);
        type T1Real = decay(T1);
        type T2Real = decay(T2);
        type T = TLeftReal.ElementType;
        let span: T[&] = this;
        static if type T2Real is operator EqualityComparer<T> {
            static if type T1Real is ISpanConvertible {
                static assert(type T == T1Real.ElementType, "ElementType mismatch");
                let values: T[&] = val1;
                let length := span.Length;
                let valuesLength := values.Length;
                outer:
                for i := isize(length) - 1u; i >= 0; --i {
                    for j in ..valuesLength {
                        if val2(span[@Unchecked i as usize], values[@Unchecked j]) {
                            continue outer;
                        }
                    }
                    return i as usize;
                }
            } else static if type T1Real is operator T {
                let length := span.Length;
                for i := isize(length) - 1u; i >= 0; --i {
                    if not val2(span[@Unchecked i as usize], val1) {
                        return i as usize;
                    }
                }
            }
        } else static if type T2Real is operator T {
            static assert(type T1Real is operator T, "ElementType mismatch");
            static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
            const simdSupported :== version(X86) or version(ARM);
            static if simdSupported and Builtin.IsBitwiseEquatable<T> {
                static if sizeof(T) == 1 {
                    return SpanHelpers.LastIndexOfAnyExceptByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(val1), Unsafe.BitCast<byte>(val2));
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.LastIndexOfAnyExceptWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(val1), Unsafe.BitCast<u16>(val2));
                }
            }
            
            return SpanHelpers.LastIndexOfAnyExceptGeneralCase(span, val1, val2);
        } else {
            static assert(false, "T1 should be ElementType or Span<ElementType>");
        }
        return null;
    }

    // Searches for the last index of any value other than of the specified values.
    // If not found, returns null.
    LastIndexOfAnyExcept: <T1, T2, T3> (forward val1: T1, forward val2: T2, forward val3: T3) -> usize? {
        type TLeftReal = decay(TLeft);
        type T1Real = decay(T1);
        type T2Real = decay(T2);
        type T3Real = decay(T3);
        type T = TLeftReal.ElementType;
        let span: T[&] = this;
        static if type T3Real is operator EqualityComparer<T> {
            static assert(type T1Real is operator T, "ElementType mismatch");
            static assert(type T2Real is operator T, "ElementType mismatch");
            let length := span.Length;
            for i := isize(length) - 1u; i >= 0; --i {
                let val := span[@Unchecked i as usize];
                if (not val3(val, val1)) and (not val3(val, val2)) {
                    return i as usize;
                }
            }
        } else static if type T3Real is operator T {
            static assert(type T1Real is operator T, "ElementType mismatch");
            static assert(type T2Real is operator T, "ElementType mismatch");
            static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
            const simdSupported :== version(X86) or version(ARM);
            static if simdSupported and Builtin.IsBitwiseEquatable<T> {
                static if sizeof(T) == 1 {
                    return SpanHelpers.LastIndexOfAnyExceptByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(val1), Unsafe.BitCast<byte>(val2),
                                Unsafe.BitCast<byte>(val3));
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.LastIndexOfAnyExceptWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(val1), Unsafe.BitCast<u16>(val2),
                                Unsafe.BitCast<u16>(val3));
                }
            }
            
            return SpanHelpers.LastIndexOfAnyExceptGeneralCase(span, val1, val2, val3);
        } else {
            static assert(false, "T1, T2, T3 should be ElementType");
        }
        return null;
    }

    // Searches for the last index of any value other than of the specified values.
    // If not found, returns null.
    LastIndexOfAnyExcept: <T1, T2, T3, TComparer> (forward val1: T1, forward val2: T2, forward val3: T3, equals: TComparer) -> usize? {
        type TLeftReal = decay(TLeft);
        type T1Real = decay(T1);
        type T2Real = decay(T2);
        type T3Real = decay(T3);
        type T4Real = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type T1Real is operator T, "ElementType mismatch");
        static assert(type T2Real is operator T, "ElementType mismatch");
        static assert(type T3Real is operator T, "ElementType mismatch");
        static assert(type T4Real is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        let span: T[&] = this;
        let length := span.Length;
        for i := isize(length) - 1u; i >= 0; --i {
            let val := span[@Unchecked i as usize];
            if (not equals(val, val1)) and (not equals(val, val2)) and (not equals(val, val3)) {
                return i as usize;
            }
        }
        return null;
    }

    // Counts the number of times any of the specified values occurs in the span.
    CountAny: <TSpan> (forward val: TSpan) -> usize {
        type TLeftReal = decay(TLeft);
        type TSpanReal = decay(TSpan);
        type T = TLeftReal.ElementType;
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        static assert(type TSpanReal is ISpanConvertible, "TSpan should be an array-like type");
        static assert(type T == TSpanReal.ElementType, "ElementType mismatch");
        span: T[&] = this;
        let values: T[&] = val;
        count: usize;
        pos := span.IndexOfAny(values);
        while pos {
            ++count;
            span = span[@Unchecked (pos! + 1)..];
            pos = span.IndexOfAny(values);
        }
        return count;
    }

    // Counts the number of times any of the specified values occurs in the span.
    CountAny: <TSpan, TComparer> (forward val: TSpan, equals: TComparer) -> usize {
        type TLeftReal = decay(TLeft);
        type TSpanReal = decay(TSpan);
        type T = TLeftReal.ElementType;
        static assert(type TComparer is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        static assert(type TSpanReal is ISpanConvertible, "TSpan should be an array-like type");
        static assert(type T == TSpanReal.ElementType, "ElementType mismatch");
        span: T[&] = this;
        let values: T[&] = val;
        count: usize;
        pos := span.IndexOfAny(values, equals);
        while pos {
            ++count;
            span = span[@Unchecked (pos! + 1)..];
            pos = span.IndexOfAny(values, equals);
        }
        return count;
    }

    // Returns true the specified value appears at the start of the span.
    StartsWith: <TValue> (forward val: TValue) -> bool == {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type T = TLeftReal.ElementType;
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        let span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            let valSpan: T[&] = val;
            let valueLength := valSpan.Length;
            static if Builtin.IsBitwiseEquatable<T> {
                return valueLength <= span.Length and SpanHelpers.SequenceEqualsByte(span[..valueLength].AsBytes, valSpan.AsBytes);
            } else {
                return valueLength <= span.Length and span[..valueLength].SequenceEquals(valSpan);
            }
        } else static if type TValueReal is operator T { 
            return not span.IsEmpty and span[@Unchecked 0] == val;
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
    }

    // Returns true the specified value appears at the start of the span.
    StartsWith: <TValue, TComparer> (forward val: TValue, equals: TComparer) -> bool {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type TComparerReal = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type TComparerReal is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        let span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            let valSpan: T[&] = val;
            let valueLength := valSpan.Length;
            return valueLength <= span.Length and span[..valueLength].SequenceEquals(valSpan, equals);
        } else static if type TValueReal is operator T { 
            return not span.IsEmpty and equals(span[@Unchecked 0], val);
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
    }

    // Returns true the specified value appears at the end of the span.
    EndsWith: <TValue> (forward val: TValue) -> bool == {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type T = TLeftReal.ElementType;
        static assert(type T is ISelfEquatable, "Search available only for ISelfEquatable types");
        let span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            let valSpan: T[&] = val;
            let valueLength := valSpan.Length;
            let spanLength := span.Length;
            static if Builtin.IsBitwiseEquatable<T> {
                return valueLength <= spanLength and SpanHelpers.SequenceEqualsByte(span[(spanLength - valueLength)..].AsBytes,
                    valSpan.AsBytes);
            } else {
                return valueLength <= spanLength and span[(spanLength - valueLength)..].SequenceEquals(valSpan);
            }
        } else static if type TValueReal is operator T { 
            return not span.IsEmpty and span[@Unchecked ^1u] == val;
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
    }

    // Returns true the specified value appears at the end of the span.
    EndsWith: <TValue, TComparer> (forward val: TValue, equals: TComparer) -> bool {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type TComparerReal = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type TComparerReal is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        let span: T[&] = this;
        static if type TValueReal is operator Span<T> {
            let valSpan: T[&] = val;
            let valueLength := valSpan.Length;
            let spanLength := span.Length;
            return valueLength <= spanLength and span[(spanLength - valueLength)..].SequenceEquals(valSpan, equals);
        } else static if type TValueReal is operator T { 
            return not span.IsEmpty and equals(span[@Unchecked ^1u], val);
        } else {
            static assert(false, "TValue should be ElementType or Span<ElementType>");
        }
    }
}

public extension <TLeft> where type TLeft is IMutableSpanConvertible {
    // Moves data to the destination span
    // Throws InvalidArgumentException if the destination span is not large enough to contain all elements
    mut MoveTo: <TDest> (forward dest: TDest) {
        type TLeftReal = decay(TLeft);
        type TDestReal = decay(TDest);
        type T = TLeftReal.ElementType;
        static assert(type TDestReal is IMutableSpanConvertible, "TDest should be mutable array-like type");
        static assert(type T == TDestReal.ElementType, "ElementType mismatch");
        let src: T[&mut] = this;
        let dst: T[&mut] = dest;
        if src.Length > dst.Length {
            throw Builtin.InvalidArgumentException();
        }

        static if Builtin.IsTriviallyCopyable<T> {
            Unsafe.CopyBlock(dst.GetDataReference(), src.GetDataReference(), src.Length * sizeof(T));
        } else {
            for i in ..src.Length {
                dst[@Unchecked i] = move (src[@Unchecked i]);
            }
        }
    }

    // Replaces all occurrences of oldValue with newValue.
    mut Replace: <TValue> (forward oldValue: TValue, forward newValue: TValue) {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type T = TLeftReal.ElementType;
        static assert(type TValueReal is operator T, "ElementType mismatch");
        static assert(type T is ISelfEquatable, "Replace available only for ISelfEquatable types");
        let buf: T[&mut] = this;
        let length := buf.Length;
        if version(X86 or ARM) {
            static if Builtin.IsBitwiseEquatable<T> {
                // SIMD path
                static if sizeof(T) == 1 {
                    return SpanHelpers.ReplaceByte(MutableSpan<byte>::UnsafeCreate(Unsafe.As<byte>(&buf[@Unchecked 0]), length), 
                        Unsafe.BitCast<byte>(oldValue), Unsafe.BitCast<byte>(newValue));
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.ReplaceWord(MutableSpan<u16>::UnsafeCreate(Unsafe.As<u16>(&buf[@Unchecked 0]), length), 
                        Unsafe.BitCast<u16>(oldValue), Unsafe.BitCast<u16>(newValue));
                } else static if sizeof(T) == 4 {
                    return SpanHelpers.ReplaceDword(MutableSpan<u32>::UnsafeCreate(Unsafe.As<u32>(&buf[@Unchecked 0]), length), 
                        Unsafe.BitCast<u32>(oldValue), Unsafe.BitCast<u32>(newValue));
                } else static if sizeof(T) == 8 {
                    return SpanHelpers.ReplaceQword(MutableSpan<u64>::UnsafeCreate(Unsafe.As<u64>(&buf[@Unchecked 0]), length), 
                        Unsafe.BitCast<u64>(oldValue), Unsafe.BitCast<u64>(newValue));
                }
            } else {
                // Regular path
                return SpanHelpers.ReplaceGeneralCase(buf, oldValue, newValue);
            }
        } else {
            return SpanHelpers.ReplaceGeneralCase(buf, oldValue, newValue);
        }
    }

    // Replaces all occurrences of oldValue with newValue using given EqualityComparer.
    mut Replace: <TValue, TComparer> (forward oldValue: TValue, forward newValue: TValue, equals: TComparer) {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type TComparerReal = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type TValue is operator T, "ElementType mismatch");
        static assert(type TComparerReal is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        let buf: T[&mut] = this;
        for &i in buf {
            if equals(i, oldValue) {
                i = newValue;
            }
        }
    }

    // Fills the elements of this span with a specified value
    mut Fill: <TValue> (forward val: TValue) {
        type TLeftReal = decay(TLeft);
        type TValueReal = decay(TValue);
        type T = TLeftReal.ElementType;
        static assert(type TValueReal is operator T, "ElementType mismatch");
        let buf: T[&mut] = this;
        static if Builtin.IsBitwiseEquatable<T> and sizeof(T) == 1 {
            Unsafe.InitBlock(Unsafe.As<byte>(&buf[@Unchecked 0]), Unsafe.BitCast<byte>(val), buf.Length);
        } else {
            for &i in buf {
                i = val;
            }
        }
    }

    // Reverses the sequence of the elements in the entire span
    mut Reverse: () {
        type TLeftReal = decay(TLeft);
        type T = TLeftReal.ElementType;
        let buf: T[&mut] = this;
        let length := buf.Length;
        if length < 2u {
            return;
        }

        const simdSupported :== version(X86) or version(ARM);
        static if simdSupported and Builtin.IsTriviallyCopyable<T> {
            static if sizeof(T) == 1 {
                SpanHelpers.ReverseBytes(MutableSpan<byte>::UnsafeCreate(Unsafe.As<byte>(&buf[@Unchecked 0]), length));
                return;
            } else static if sizeof(T) == 2 {
                SpanHelpers.ReverseWords(MutableSpan<u16>::UnsafeCreate(Unsafe.As<u16>(&buf[@Unchecked 0]), length));
                return;
            } else static if sizeof(T) == 4 {
                SpanHelpers.ReverseDwords(MutableSpan<u32>::UnsafeCreate(Unsafe.As<u32>(&buf[@Unchecked 0]), length));
                return;
            } else static if sizeof(T) == 8 {
                SpanHelpers.ReverseQwords(MutableSpan<u64>::UnsafeCreate(Unsafe.As<u64>(&buf[@Unchecked 0]), length));
                return;
            }
        }

        SpanHelpers.ReverseGeneralCase(buf);
    }
}

protected static class SpanHelpers {
    public ContainsGeneralCase: <T> (data: T[&], in ref val: T) -> bool {
        length := data.Length;
        offset: i32;
        while length >= 8u {
            length -= 8u;

            if data[@Unchecked offset] == val or
                data[@Unchecked offset + 1] == val or
                data[@Unchecked offset + 2] == val or
                data[@Unchecked offset + 3] == val or
                data[@Unchecked offset + 4] == val or
                data[@Unchecked offset + 5] == val or
                data[@Unchecked offset + 6] == val or
                data[@Unchecked offset + 7] == val
            {
                return true;
            }

            offset += 8;
        }

        while length >= 4u {
            length -= 4u;

            if data[@Unchecked offset] == val or
                data[@Unchecked offset + 1] == val or
                data[@Unchecked offset + 2] == val or
                data[@Unchecked offset + 3] == val
            {
                return true;
            }

            offset += 4;
        }

        while length > 0 {
            --length;
            if data[@Unchecked offset] == val {
                return true;
            }
            ++offset;
        }
        return false;
    }

    public ContainsByte: (data: byte[&], val: byte) -> bool {
        let length := data.Length;
        if length < 16u {
            return ContainsGeneralCase(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanContains<byte>, Neon, Sse2>(data, val);
        } else if length < 64u {
            return Simd.RuntimeDispatch<SpanContains<byte>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanContains<byte>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public ContainsWord: (data: u16[&], val: u16) -> bool {
        let length := data.Length;
        if length < 8u {
            return ContainsGeneralCase(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanContains<u16>, Neon, Sse2>(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanContains<u16>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanContains<u16>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public ContainsDword: (data: u32[&], val: u32) -> bool {
        let length := data.Length;
        if length < 4u {
            return ContainsGeneralCase(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanContains<u32>, Neon, Avx512VL128, Sse2>(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanContains<u32>, Neon, Avx512VL256, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanContains<u32>, Neon, Avx512F, Avx2, Sse2>(data, val);
        }
    }

    public ContainsQword: (data: u64[&], val: u64) -> bool {
        let length := data.Length;
        if length < 2u {
            return ContainsGeneralCase(data, val);
        } else if length < 4u {
            return Simd.RuntimeDispatch<SpanContains<u64>, Neon, Avx512VL128, Sse42, Sse2>(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanContains<u64>, Neon, Avx512VL256, Avx2, Sse42, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanContains<u64>, Neon, Avx512F, Avx2, Sse42, Sse2>(data, val);
        }
    }

    public CountGeneralCase: <T> (data: T[&], val: T) -> usize {
        count: usize;
        for i in data {
            if i == val {
                ++count;
            }
        }
        return count;
    }

    public CountBytes: (data: byte[&], val: byte) -> usize {
        let length := data.Length;
        if length < 16u {
            return CountGeneralCase(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanCount<byte>, Neon, Sse2>(data, val);
        } else if length < 64u {
            return Simd.RuntimeDispatch<SpanCount<byte>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanCount<byte>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public CountWords: (data: u16[&], val: u16) -> usize {
        let length := data.Length;
        if length < 8u {
            return CountGeneralCase(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanCount<u16>, Neon, Sse2>(data, val);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanCount<u16>, Neon, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanCount<u16>, Neon, Avx512BW, Avx2, Sse2>(data, val);
        }
    }

    public CountDwords: (data: u32[&], val: u32) -> usize {
        let length := data.Length;
        if length < 4u {
            return CountGeneralCase(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanCount<u32>, Neon, Avx512VL128, Sse2>(data, val);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanCount<u32>, Neon, Avx512VL256, Avx2, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanCount<u32>, Neon, Avx512F, Avx2, Sse2>(data, val);
        }
    }

    public CountQwords: (data: u64[&], val: u64) -> usize {
        let length := data.Length;
        if length < 2u {
            return CountGeneralCase(data, val);
        } else if length < 4u {
            return Simd.RuntimeDispatch<SpanCount<u64>, Neon, Avx512VL128, Sse42, Sse2>(data, val);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanCount<u64>, Neon, Avx512VL256, Avx2, Sse42, Sse2>(data, val);
        } else {
            return Simd.RuntimeDispatch<SpanCount<u64>, Neon, Avx512F, Avx2, Sse42, Sse2>(data, val);
        }
    }

    public Mismatch: (left: byte[&], right: byte[&], length: usize) -> usize {
        //assert left.Length <= length and right.Length <= length;
        index: usize;

        if length < 16u {
            index = length % 4u;
            if index {
                if left[@Unchecked 0] != right[@Unchecked 0] {
                    return 0u;
                }

                if index > 1u {
                    if left[@Unchecked 1] != right[@Unchecked 1] {
                        return 1u;
                    }

                    if index > 2u and left[@Unchecked 2] != right[@Unchecked 2] {
                        return 2u;
                    }
                }
            }

            while index <= length - 4u {
                if left[@Unchecked index] != right[@Unchecked index] {
                    return index;
                }
                if left[@Unchecked index + 1u] != right[@Unchecked index + 1u] {
                    return index + 1u;
                }
                if left[@Unchecked index + 2u] != right[@Unchecked index + 2u] {
                    return index + 2u;
                }
                if left[@Unchecked index + 3u] != right[@Unchecked index + 3u] {
                    return index + 3u;
                }

                index += 4u;
            }
            return length;
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanMismatch, Neon, Sse2>(left, right, length);
        } else if length < 64u {
            return Simd.RuntimeDispatch<SpanMismatch, Neon, Avx2, Sse2>(left, right, length);
        } else {
            return Simd.RuntimeDispatch<SpanMismatch, Neon, Avx512BW, Avx2, Sse2>(left, right, length);
        }
    }

    public IndexOfGeneralCase: <T> (data: T[&], in ref val: T) -> usize? {
        length := data.Length;
        index: usize;
        while length >= 8u {
            length -= 8u;

            if data[@Unchecked index] == val
            {
                return index;
            }
            if data[@Unchecked index + 1u] == val
            {
                return index + 1u;
            }
            if data[@Unchecked index + 2u] == val
            {
                return index + 2u;
            }
            if data[@Unchecked index + 3u] == val
            {
                return index + 3u;
            }
            if data[@Unchecked index + 4u] == val
            {
                return index + 4u;
            }
            if data[@Unchecked index + 5u] == val
            {
                return index + 5u;
            }
            if data[@Unchecked index + 6u] == val
            {
                return index + 6u;
            }
            if data[@Unchecked index + 7u] == val
            {
                return index + 7u;
            }

            index += 8;
        }

        while length >= 4u {
            length -= 4u;

            if data[@Unchecked index] == val
            {
                return index;
            }
            if data[@Unchecked index + 1u] == val
            {
                return index + 1u;
            }
            if data[@Unchecked index + 2u] == val
            {
                return index + 2u;
            }
            if data[@Unchecked index + 3u] == val
            {
                return index + 3u;
            }

            index += 4;
        }

        while length > 0 {
            --length;
            if data[@Unchecked index] == val {
                return index;
            }
            ++index;
        }
        return null;
    }

