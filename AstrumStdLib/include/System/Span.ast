    public LastIndexOfGeneralCase: <T> (data: T[&], in ref val: T) -> usize? {
        length := data.Length;
        index := length - 1u;
        while length >= 8u {
            length -= 8u;

            if data[@Unchecked index] == val
            {
                return index;
            }
            if data[@Unchecked index - 1u] == val
            {
                return index - 1u;
            }
            if data[@Unchecked index - 2u] == val
            {
                return index - 2u;
            }
            if data[@Unchecked index - 3u] == val
            {
                return index - 3u;
            }
            if data[@Unchecked index - 4u] == val
            {
                return index - 4u;
            }
            if data[@Unchecked index - 5u] == val
            {
                return index - 5u;
            }
            if data[@Unchecked index - 6u] == val
            {
                return index - 6u;
            }
            if data[@Unchecked index - 7u] == val
            {
                return index - 7u;
            }

            index -%= 8;
        }

        while length >= 4u {
            length -= 4u;

            if data[@Unchecked index] == val
            {
                return index;
            }
            if data[@Unchecked index - 1u] == val
            {
                return index - 1u;
            }
            if data[@Unchecked index - 2u] == val
            {
                return index - 2u;
            }
            if data[@Unchecked index - 3u] == val
            {
                return index - 3u;
            }

            index -%= 4;
        }

        while length > 0 {
            --length;
            if data[@Unchecked index] == val {
                return index;
            }
            --%index;
        }
        return null;
    }

    public LastIndexOfByte: (data: byte[&], val: byte) -> usize? {
        let length := data.Length;
