    public ReverseGeneralCase: <T> (buf: T[&mut]) {
        assert buf.Length >= 2u;
        first: &mut T = &buf[@Unchecked 0];
        last: &mut T = &buf[@Unchecked ^1u];
        do {
            let tmp := T(first);
            first = T(last);
            last = tmp;
            first = Unsafe.Add(first, 1u);
            last = Unsafe.Subtract(last, 1u);
        } while Unsafe.IsAddressLessThan(first, last);
    }

    public ReverseBytes: (buf: byte[&mut]) {
        let length := buf.Length;
        if length < 32u {
            ReverseGeneralCase(buf);
        } else if length < 48u {
            Simd.RuntimeDispatch<SpanReverse<byte>, Neon64, Neon, Sse42, Sse2>(buf);
        } else if length < 128u {
            Simd.RuntimeDispatch<SpanReverse<byte>, Neon64, Neon, Avx2, Sse42, Sse2>(buf);
        } else {
            Simd.RuntimeDispatch<SpanReverse<byte>, Neon64, Neon, Avx512Vbmi, Avx2, Sse42, Sse2>(buf);
        }
    }

