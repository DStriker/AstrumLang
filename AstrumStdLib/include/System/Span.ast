    public LastIndexOfInternal: <T> (data: T[&], val: T[&]) -> usize? {
        let dataLength := data.Length;
        let valueLength := val.Length;
        if valueLength == 0 {
            return dataLength;
        }

        let valueHead := val[@Unchecked 0];
        let valueTail := val[@Unchecked 1u..];
        let valueTailLength := valueLength - 1u;
        if valueTailLength == 0 {
            return data.LastIndexOf(valueHead);
        }

        index: usize;

        for {
            assert index <= dataLength;
            let remainingLength := dataLength -% index -% valueTailLength;
            if remainingLength.NarrowToIsize() <= 0 {
                break;
            }

            if let relativeIndex := data[@Unchecked ..remainingLength].LastIndexOf(valueHead) {
                if data.SliceUnchecked(relativeIndex + 1, valueTailLength).SequenceEquals(valueTail) {
                    return relativeIndex;
                }
                index += remainingLength - relativeIndex;
            } else {
                break;
            }
        }
        return null;
    }

    public LastIndexOfAnyInternal: <T> (data: T[&], val: T[&]) -> usize? {
        let dataLength := data.Length;
        let valueLength := val.Length;
        if valueLength == 0 {
            return null;
        }

        for i := isize(dataLength) - 1; i >= 0; --i {
            let candidate := data[@Unchecked i as usize];
            for j in ..valueLength {
                if candidate == val[@Unchecked j] {
                    return i as usize;
                }
            }
        }
        return null;
    }

    public LastIndexOfAnyGeneralCase: <T> (data: T[&], in ref val1: T, in ref val2: T) -> usize? {
        length := data.Length;
        index := length - 1u;
        while length >= 8u {
            length -= 8u;

            lookup := data[@Unchecked index];
            if lookup == val1 or lookup == val2
            {
                return index;
            }
            lookup = data[@Unchecked index - 1u];
            if lookup == val1 or lookup == val2
            {
                return index - 1u;
            }
            lookup = data[@Unchecked index - 2u];
            if lookup == val1 or lookup == val2
            {
                return index - 2u;
            }
            lookup = data[@Unchecked index - 3u];
            if lookup == val1 or lookup == val2
            {
                return index - 3u;
            }
            lookup = data[@Unchecked index - 4u];
            if lookup == val1 or lookup == val2
            {
                return index - 4u;
            }
            lookup = data[@Unchecked index - 5u];
            if lookup == val1 or lookup == val2
            {
                return index - 5u;
            }
            lookup = data[@Unchecked index - 6u];
            if lookup == val1 or lookup == val2
            {
                return index - 6u;
            }
            lookup = data[@Unchecked index - 7u];
            if lookup == val1 or lookup == val2
            {
                return index - 7u;
            }

            index -%= 8;
        }

        while length >= 4u {
            length -= 4u;

            lookup := data[@Unchecked index];
            if lookup == val1 or lookup == val2
            {
                return index;
            }
            lookup = data[@Unchecked index - 1u];
            if lookup == val1 or lookup == val2
            {
                return index - 1u;
            }
            lookup = data[@Unchecked index - 2u];
            if lookup == val1 or lookup == val2
            {
                return index - 2u;
            }
            lookup = data[@Unchecked index - 3u];
            if lookup == val1 or lookup == val2
            {
                return index - 3u;
            }

            index -%= 4;
        }

        while length > 0 {
            --length;
            lookup := data[@Unchecked index];
            if lookup == val1 or lookup == val2 {
                return index;
            }
            --%index;
        }
        return null;
    }

