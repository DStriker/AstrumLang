private static class <T> SpanIndexOfAnyInRange {
    public Invoke: <Arch> (data: T[&], start: T, end: T) -> usize? {
        type TVector = SimdVector<T, Arch>;
        type TMask = SimdMask<T, Arch>;
        const vecSize :== TVector::Length;
        let count := data.Length;
        let vecLast := count - vecSize;
        let low := TVector::Create(start);
        let range := TVector::Create(end - start);
        current: TVector;
        currentMask: TMask;
        for i := 0u; i <= vecLast; i += vecSize {
            current = TVector::LoadUnsafe(data[@Unchecked i]) -% low;
            currentMask = current <=^ range;
            if let index := currentMask.LeadingZeros {
                return index + i;
            }
        }
        if not count.IsMultipleOf(vecSize) {
            current = TVector::LoadUnsafe(data[@Unchecked vecLast]);
            currentMask = (current -% low) <=^ range;
            if let index := currentMask.LeadingZeros {
                return index + vecLast;
            }
        }
        return null;
    }
}

