    public IndexOfAnyExceptInternal: <T> (data: T[&], val: T[&]) -> usize? {
        let dataLength := data.Length;
        let valueLength := val.Length;
        if valueLength == 0 {
            return null;
        }

        outer:
        for i in ..dataLength {
            let candidate := data[@Unchecked i];
            for j in ..valueLength {
                if candidate == val[@Unchecked j] {
                    continue outer;
                }
            }
            return i;
        }
        return null;
    }

    public IndexOfAnyExceptGeneralCase: <T> (data: T[&], in ref val: T) -> usize? {
        length := data.Length;
        index: usize;
        while length >= 8u {
            length -= 8u;

            if data[@Unchecked index] != val
            {
                return index;
            }
            if data[@Unchecked index + 1u] != val
            {
                return index + 1u;
            }
            if data[@Unchecked index + 2u] != val
            {
                return index + 2u;
            }
            if data[@Unchecked index + 3u] != val
            {
                return index + 3u;
            }
            if data[@Unchecked index + 4u] != val
            {
                return index + 4u;
            }
            if data[@Unchecked index + 5u] != val
            {
                return index + 5u;
            }
            if data[@Unchecked index + 6u] != val
            {
                return index + 6u;
            }
            if data[@Unchecked index + 7u] != val
            {
                return index + 7u;
            }

            index += 8;
        }

        while length >= 4u {
            length -= 4u;

            if data[@Unchecked index] != val
            {
                return index;
            }
            if data[@Unchecked index + 1u] != val
            {
                return index + 1u;
            }
            if data[@Unchecked index + 2u] != val
            {
                return index + 2u;
            }
            if data[@Unchecked index + 3u] != val
            {
                return index + 3u;
            }

            index += 4;
        }

        while length > 0 {
            --length;
            if data[@Unchecked index] != val {
                return index;
            }
            ++index;
        }
        return null;
    }

    public IndexOfAnyExceptGeneralCase: <T> (data: T[&], in ref val1: T, in ref val2: T) -> usize? {
        length := data.Length;
        index: usize;
        while length >= 8u {
            length -= 8u;

            lookup := data[@Unchecked index];
            if lookup != val1 and lookup != val2
            {
                return index;
            }
            lookup = data[@Unchecked index + 1u];
            if lookup != val1 and lookup != val2
            {
                return index + 1u;
            }
            lookup = data[@Unchecked index + 2u];
            if lookup != val1 and lookup != val2
            {
                return index + 2u;
            }
            lookup = data[@Unchecked index + 3u];
            if lookup != val1 and lookup != val2
            {
                return index + 3u;
            }
            lookup = data[@Unchecked index + 4u];
            if lookup != val1 and lookup != val2
            {
                return index + 4u;
            }
            lookup = data[@Unchecked index + 5u];
            if lookup != val1 and lookup != val2
            {
                return index + 5u;
            }
            lookup = data[@Unchecked index + 6u];
            if lookup != val1 and lookup != val2
            {
                return index + 6u;
            }
            lookup = data[@Unchecked index + 7u];
            if lookup != val1 and lookup != val2
            {
                return index + 7u;
            }

            index += 8;
        }

        while length >= 4u {
            length -= 4u;

            lookup := data[@Unchecked index];
            if lookup != val1 and lookup != val2
            {
                return index;
            }
            lookup = data[@Unchecked index + 1u];
            if lookup != val1 and lookup != val2
            {
                return index + 1u;
            }
            lookup = data[@Unchecked index + 2u];
            if lookup != val1 and lookup != val2
            {
                return index + 2u;
            }
            lookup = data[@Unchecked index + 3u];
            if lookup != val1 and lookup != val2
            {
                return index + 3u;
            }

            index += 4;
        }

        while length > 0 {
            --length;
            lookup := data[@Unchecked index];
            if lookup != val1 and lookup != val2 {
                return index;
            }
            ++index;
        }
        return null;
    }

