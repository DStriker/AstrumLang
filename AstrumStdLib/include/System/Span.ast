            return Simd.RuntimeDispatch<SpanIndexOfAnyExceptInRange<u16>, Neon, Sse2>(data, start, end);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanIndexOfAnyExceptInRange<u16>, Neon, Avx2, Sse2>(data, start, end);
        } else {
            return Simd.RuntimeDispatch<SpanIndexOfAnyExceptInRange<u16>, Neon, Avx512BW, Avx2, Sse2>(data, start, end);
        }
    }

    public IndexOfAnyExceptInRangeDword: (data: u32[&], start: u32, end: u32) -> usize? {
        let length := data.Length;
        if length < 4u {
            return IndexOfAnyExceptInRangeGeneralCase(data, start, end);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanIndexOfAnyExceptInRange<u32>, Neon, Avx512VL128, Sse2>(data, start, end);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanIndexOfAnyExceptInRange<u32>, Neon, Avx512VL256, Avx2, Sse2>(data, start, end);
        } else {
            return Simd.RuntimeDispatch<SpanIndexOfAnyExceptInRange<u32>, Neon, Avx512F, Avx2, Sse2>(data, start, end);
        }
    }

    public IndexOfAnyExceptInRangeQword: (data: u64[&], start: u64, end: u64) -> usize? {
        let length := data.Length;
        if length < 2u {
            return IndexOfAnyExceptInRangeGeneralCase(data, start, end);
        } else if length < 4u {
            return Simd.RuntimeDispatch<SpanIndexOfAnyExceptInRange<u64>, Neon, Avx512VL128, Sse42, Sse2>(data, start, end);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanIndexOfAnyExceptInRange<u64>, Neon, Avx512VL256, Avx2, Sse42, Sse2>(data, start, end);
        } else {
            return Simd.RuntimeDispatch<SpanIndexOfAnyExceptInRange<u64>, Neon, Avx512F, Avx2, Sse42, Sse2>(data, start, end);
        }
    }

    public SequenceEqualsGeneralCase: <T> (lhs: T[&], rhs: T[&]) -> bool {
        length := lhs.Length;
        offset: i32;
        while length >= 8u {
            length -= 8u;

            if lhs[@Unchecked offset] != rhs[@Unchecked offset] or
                lhs[@Unchecked offset + 1] != rhs[@Unchecked offset + 1] or
                lhs[@Unchecked offset + 2] != rhs[@Unchecked offset + 2] or
                lhs[@Unchecked offset + 3] != rhs[@Unchecked offset + 3] or
                lhs[@Unchecked offset + 4] != rhs[@Unchecked offset + 4] or
                lhs[@Unchecked offset + 5] != rhs[@Unchecked offset + 5] or
                lhs[@Unchecked offset + 6] != rhs[@Unchecked offset + 6] or
                lhs[@Unchecked offset + 7] != rhs[@Unchecked offset + 7]
            {
                return false;
            }

            offset += 8;
        }

        while length >= 4u {
            length -= 4u;

            if lhs[@Unchecked offset] != rhs[@Unchecked offset] or
                lhs[@Unchecked offset + 1] != rhs[@Unchecked offset + 1] or
                lhs[@Unchecked offset + 2] != rhs[@Unchecked offset + 2] or
                lhs[@Unchecked offset + 3] != rhs[@Unchecked offset + 3]
            {
                return false;
            }

            offset += 4;
        }

        while length > 0 {
            --length;
            if lhs[@Unchecked offset] != rhs[@Unchecked offset] {
                return false;
            }
            ++offset;
        }
        return true;
    }

    public SequenceEqualsByte: (lhs: byte[&], rhs: byte[&]) -> bool {
        let length := lhs.Length;
        if length < 16u {
            return SequenceEqualsGeneralCase(lhs, rhs);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanSequenceEquals<byte>, Neon, Sse2>(lhs, rhs);
        } else if length < 64u {
            return Simd.RuntimeDispatch<SpanSequenceEquals<byte>, Neon, Avx2, Sse2>(lhs, rhs);
        } else {
            return Simd.RuntimeDispatch<SpanSequenceEquals<byte>, Neon, Avx512BW, Avx2, Sse2>(lhs, rhs);
        }
    }

    public SequenceEqualsWord: (lhs: u16[&], rhs: u16[&]) -> bool {
        let length := lhs.Length;
        if length < 8u {
            return SequenceEqualsGeneralCase(lhs, rhs);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanSequenceEquals<u16>, Neon, Sse2>(lhs, rhs);
        } else if length < 32u {
            return Simd.RuntimeDispatch<SpanSequenceEquals<u16>, Neon, Avx2, Sse2>(lhs, rhs);
        } else {
            return Simd.RuntimeDispatch<SpanSequenceEquals<u16>, Neon, Avx512BW, Avx2, Sse2>(lhs, rhs);
        }
    }

    public SequenceEqualsDword: (lhs: u32[&], rhs: u32[&]) -> bool {
        let length := lhs.Length;
        if length < 4u {
            return SequenceEqualsGeneralCase(lhs, rhs);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanSequenceEquals<u32>, Neon, Avx512VL128, Sse2>(lhs, rhs);
        } else if length < 16u {
            return Simd.RuntimeDispatch<SpanSequenceEquals<u32>, Neon, Avx512VL256, Avx2, Sse2>(lhs, rhs);
        } else {
            return Simd.RuntimeDispatch<SpanSequenceEquals<u32>, Neon, Avx512F, Avx2, Sse2>(lhs, rhs);
        }
    }

    public SequenceEqualsQword: (lhs: u64[&], rhs: u64[&]) -> bool {
        let length := lhs.Length;
        if length < 2u {
            return SequenceEqualsGeneralCase(lhs, rhs);
        } else if length < 4u {
            return Simd.RuntimeDispatch<SpanSequenceEquals<u64>, Neon, Avx512VL128, Sse42, Sse2>(lhs, rhs);
        } else if length < 8u {
            return Simd.RuntimeDispatch<SpanSequenceEquals<u64>, Neon, Avx512VL256, Avx2, Sse42, Sse2>(lhs, rhs);
        } else {
            return Simd.RuntimeDispatch<SpanSequenceEquals<u64>, Neon, Avx512F, Avx2, Sse42, Sse2>(lhs, rhs);
        }
    }
}

private static class <T> SpanContains {
    public Invoke: <Arch> (data: T[&], val: T) -> bool {
        type TVector = SimdVector<T, Arch>;
        const vecSize :== TVector::Length;
        let count := data.Length;
        let vecLast := count - vecSize;
        let values := TVector::Create(val);
        current: TVector;
        for i := 0u; i <= vecLast; i += vecSize {
            current = TVector::LoadUnsafe(data[@Unchecked i]);
            if current.EqualsAny(values) {
                return true;
            }
        }
        if not count.IsMultipleOf(vecSize) {
            current = TVector::LoadUnsafe(data[@Unchecked vecLast]);
            if current.EqualsAny(values) {
                return true;
            }
        }
        return false;
    }
}

private static class SpanMismatch {
    public Invoke: <Arch> (left: byte[&], right: byte[&], length: usize) -> usize {
        type TVector = SimdVector<byte, Arch>;
        type TMask = SimdMask<byte, Arch>;
        const vecSize :== TVector::Length;
        let vecLast := length - vecSize;
        index: usize;
        maskVec: TMask;
        while index < vecLast {
            maskVec = TVector::LoadUnsafe(left[@Unchecked index]) !=^ TVector::LoadUnsafe(right[@Unchecked index]);
            if let i := maskVec.FirstSet {
                return index + i;
            }
            index += vecSize;
        }
        index = vecLast;
        maskVec = TVector::LoadUnsafe(left[@Unchecked index]) !=^ TVector::LoadUnsafe(right[@Unchecked index]);
        if let i := maskVec.FirstSet {
            return index + i;
        }
        return length;
    }
}

private static class <T> SpanCount {
    public Invoke: <Arch> (data: T[&], val: T) -> usize {
        type TVector = SimdVector<T, Arch>;
        type TMask = SimdMask<T, Arch>;
        const vecSize :== TVector::Length;
        let length := data.Length;
        let vecLast := length - vecSize;
        let values := TVector::Create(val);
        currentVec: TVector;
        currentMask: TMask;
        count: usize;
        i: usize;
        for ; i < vecLast; i += vecSize {
            currentVec = TVector::LoadUnsafe(data[@Unchecked i]);
            currentMask = currentVec ==^ values;
            count += currentMask.Count;
        }
        mask := (TVector::LoadUnsafe(data[@Unchecked vecLast]) ==^ values).ScalarMask;
        mask >>= i - vecLast;
        count += mask.PopCount;
        return count;
    }
}

private static class <T> SpanIndexOf {
    public Invoke: <Arch> (data: T[&], val: T) -> usize? {
        type TVector = SimdVector<T, Arch>;
        type TMask = SimdMask<T, Arch>;
        const vecSize :== TVector::Length;
        let count := data.Length;
        let vecLast := count - vecSize;
        let values := TVector::Create(val);
        current: TVector;
        currentMask: TMask;
        for i := 0u; i <= vecLast; i += vecSize {
            current = TVector::LoadUnsafe(data[@Unchecked i]);
            currentMask = current ==^ values;
            if let index := currentMask.LeadingZeros {
                return index + i;
            }
        }
        if not count.IsMultipleOf(vecSize) {
            current = TVector::LoadUnsafe(data[@Unchecked vecLast]);
            currentMask = current ==^ values;
            if let index := currentMask.LeadingZeros {
                return index + vecLast;
            }
        }
        return null;
    }
}

