    public IndexOfAnyExceptInRangeGeneralCase: <T> (data: T[&], in ref start: T, in ref end: T) -> usize? {
        length := data.Length;
        index: usize;
        for i in ..length {
            let &current := data[@Unchecked i];
            if current not in start..=end {
                return i;
            }
        }
        return null;
    }

