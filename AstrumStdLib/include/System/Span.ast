                static if sizeof(T) == 1 {
                    return SpanHelpers.IndexOfAnyByte(Span<byte>::UnsafeCreate(Unsafe.As<byte>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<byte>(val1), Unsafe.BitCast<byte>(val2),
                                Unsafe.BitCast<byte>(val3));
                } else static if sizeof(T) == 2 {
                    return SpanHelpers.IndexOfAnyWord(Span<u16>::UnsafeCreate(Unsafe.As<u16>(span[@Unchecked 0]), span.Length), 
                                Unsafe.BitCast<u16>(val1), Unsafe.BitCast<u16>(val2),
                                Unsafe.BitCast<u16>(val3));
                }
            }
            
            return SpanHelpers.IndexOfAnyGeneralCase(span, val1, val2, val3);
        } else {
            static assert(false, "T1, T2, T3 should be ElementType");
        }
        return null;
    }

    ContainsAny: <T1, T2, T3> (forward val1: T1, forward val2: T2, forward val3: T3) -> bool 
        => this.IndexOfAny(forward val1, forward val2, forward val3) != null;

    // Searches for the first index of any of the specified values
    // If not found, returns null.
    IndexOfAny: <T1, T2, T3, TComparer> (forward val1: T1, forward val2: T2, forward val3: T3, equals: TComparer) -> usize? {
        type TLeftReal = decay(TLeft);
        type T1Real = decay(T1);
        type T2Real = decay(T2);
        type T3Real = decay(T3);
        type T4Real = decay(TComparer);
        type T = TLeftReal.ElementType;
        static assert(type T1Real is operator T, "ElementType mismatch");
        static assert(type T2Real is operator T, "ElementType mismatch");
        static assert(type T3Real is operator T, "ElementType mismatch");
        static assert(type T4Real is operator EqualityComparer<T>, "TComparer should be EqualityComparer<T>");
        let span: T[&] = this;
        let length := span.Length;
        for i in ..length {
            let val := span[@Unchecked i];
            if equals(val, val1) or equals(val, val2) or equals(val, val3) {
                return i;
            }
        }
        return null;
    }

    ContainsAny: <T1, T2, T3, TComparer> (forward val1: T1, forward val2: T2, forward val3: T3, equals: TComparer) -> bool 
        => this.IndexOfAny(forward val1, forward val2, forward val3, equals) != null;

