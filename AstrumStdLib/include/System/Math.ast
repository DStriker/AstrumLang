package System;

public import Int8;
public import UInt8;
public import Int16;
public import UInt16;
public import Int32;
public import UInt32;
public import Int64;
public import UInt64;
public import Int128;
public import UInt128;

public static class Math {
    private type IsqrtData = (u8, u8);

    private const _isqrtLookupTable: IsqrtData[256] == () {
        result: IsqrtData[256];
        n: usize = 0u;
        rootN: usize = 0u;

        while n < 256 {
            result[n as i32] = (rootN as u8, (n - rootN ^^ 2u) as u8);
            n++;
            if n == (rootN + 1) ^^ 2u {
                rootN++;
            }
        }

        return result;
    }();

    private const EVEN_MAKING_BITMASK :== ~1u;
    private _isqrtFirstStage: <T: is IFixedWidthInteger> (num: T) -> (u8, u8) ==
    {
        assert num != 0;

        const SHIFT :== T.BitWidth - 8;
        num >>= SHIFT as i32;

        return _isqrtLookupTable[num as i32];
    }
    private _isqrtMiddleStage: <T: is IFixedWidthInteger, U: is IFixedWidthInteger> (num: T, root, rem) -> (U, U) ==
    {
        assert root != 0;

        const SHIFT :== T.BitWidth - U.BitWidth;
        const HALF_BITS :== U.BitWidth >> 1;
        const QUARTER_BITS :== U.BitWidth >> 2;
        const LOWER_HALF_BITS :== U((1u64 << HALF_BITS) - 1);
        const LOWER_QUARTER_BITS :== U((1u64 << QUARTER_BITS) - 1);
        let n := U(num >> (SHIFT as i32));

        let low := n & LOWER_HALF_BITS;
        let numerator := (U(rem) << QUARTER_BITS) | (low >> QUARTER_BITS);
        let denominator := U(root) << 1;
        let q, u := numerator /% denominator;

        r: U;
        s := U(root << QUARTER_BITS) + q;
        let sub, overflow := ((u << QUARTER_BITS) | (low & LOWER_QUARTER_BITS)) -%? (q * q);
        r = sub;
        if overflow {
            r +%= (s * 2 - 1);
            s--;
        }

        return (s, r);
    }
    private _isqrtLastStage: <T: is IFixedWidthInteger> (num: T, root, rem) -> T ==
    {
        assert root != 0;

        const HALF_BITS :== T.BitWidth >> 1;
        const QUARTER_BITS :== T.BitWidth >> 2;
        const LOWER_HALF_BITS :== T((1u128 << HALF_BITS) - 1);
        let low := num & LOWER_HALF_BITS;
        let numerator := (T(rem) << QUARTER_BITS) | (low >> QUARTER_BITS);
        let denominator := T(root) << 1;
        let q := numerator \ denominator;
        result := T(root << QUARTER_BITS) + q;
        let squared, overflow := result *%? result;
        if overflow or squared > num {
            --result;
        }

        return result;
    }

    public Isqrt8: (num: u8) -> u8 noexcept ==> _isqrtLookupTable[num as i32].0;

    public Isqrt16: (num: u16) -> u16 ==
    {
        if num <= u8.MaxValue {
            return Isqrt8(num as u8);
        }

        let normShift := num.LeadingZeroCount & EVEN_MAKING_BITMASK;
        num <<= normShift;

        let s, r := _isqrtFirstStage(num);
        let result := _isqrtLastStage(num, s, r);

        let denormShift := normShift >> 1;
        return result >> denormShift;
    }

    public Isqrt32: (num: u32) -> u32 ==
    {
        if num <= u16.MaxValue {
            return Isqrt16(num as u16);
        }

        let normShift := num.LeadingZeroCount & EVEN_MAKING_BITMASK;
        num <<= normShift;

        let s1, r1 := _isqrtFirstStage(num);
        let s2, r2 := _isqrtMiddleStage<u32, u16>(num, s1, r1);
        let result := _isqrtLastStage(num, s2, r2);

        let denormShift := normShift >> 1;
        return result >> denormShift;
    }

    public Isqrt64: (num: u64) -> u64 ==
    {
        if num <= u32.MaxValue {
            return Isqrt32(num as u32);
        }

        let normShift := num.LeadingZeroCount & EVEN_MAKING_BITMASK;
        num <<= normShift;

        let s1, r1 := _isqrtFirstStage(num);
        let s2, r2 := _isqrtMiddleStage<u64, u16>(num, s1, r1);
        let s3, r3 := _isqrtMiddleStage<u64, u32>(num, s2, r2);
        let result := _isqrtLastStage(num, s3, r3);

        let denormShift := normShift >> 1;
        return result >> denormShift;
    }

    public Isqrt128: (num: u128) -> u128 ==
    {
        if num <= u64.MaxValue {
            return Isqrt64(num as u64);
        }

        let normShift := num.LeadingZeroCount & EVEN_MAKING_BITMASK;
        num <<= normShift as i32;

        let s1, r1 := _isqrtFirstStage(num);
        let s2, r2 := _isqrtMiddleStage<u128, u16>(num, s1, r1);
        let s3, r3 := _isqrtMiddleStage<u128, u32>(num, s2, r2);
        let s4, r4 := _isqrtMiddleStage<u128, u64>(num, s3, r3);
        let result := _isqrtLastStage(num, s4, r4);

        let denormShift := normShift >> 1;
        return result >> (denormShift as i32);
    }

    public Add: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs + rhs;
    public WrappingAdd: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs +% rhs;
    public SaturatingAdd: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs +| rhs;
    public StrictAdd: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs +! rhs;
    public CheckedAdd: <T, U> (lhs: T, rhs: U) -> decay(T)? ==> lhs +? rhs;
    public OverflowingAdd: <T, U> (lhs: T, rhs: U) -> (decay(T), bool) ==> lhs +%? rhs;
    public Subtract: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs - rhs;
    public WrappingSubtract: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs -% rhs;
    public SaturatingSubtract: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs -| rhs;
    public StrictSubtract: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs -! rhs;
    public CheckedSubtract: <T, U> (lhs: T, rhs: U) -> decay(T)? ==> lhs -? rhs;
    public OverflowingSubtract: <T, U> (lhs: T, rhs: U) -> (decay(T), bool) ==> lhs -%? rhs;
    public Multiply: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs * rhs;
    public WrappingMultiply: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs *% rhs;
    public SaturatingMultiply: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs *| rhs;
    public StrictMultiply: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs *! rhs;
    public CheckedMultiply: <T, U> (lhs: T, rhs: U) -> decay(T)? ==> lhs *? rhs;
    public OverflowingMultiply: <T, U> (lhs: T, rhs: U) -> (decay(T), bool) ==> lhs *%? rhs;
    public IPow: <T, U> (lhs: T, rhs: U) -> _ ==> lhs ^^ rhs;
    public WrappingIPow: <T, U> (lhs: T, rhs: U) -> _ ==> lhs ^^% rhs;
    public SaturatingIPow: <T, U> (lhs: T, rhs: U) -> _ ==> lhs ^^| rhs;
    public StrictIPow: <T, U> (lhs: T, rhs: U) -> _ ==> lhs ^^! rhs;
    public CheckedIPow: <T, U> (lhs: T, rhs: U) -> _ ==> lhs ^^? rhs;
    public OverflowingIPow: <T, U> (lhs: T, rhs: U) -> _ ==> lhs ^^%? rhs;
    public Pow: <T, U> (lhs: T, rhs: U) -> _ ==> lhs ** rhs;
    public Divide: <T, U> (lhs: T, rhs: U) -> _ ==> lhs / rhs;
    public IntegerDivide: <T, U> (lhs: T, rhs: U) -> _ ==> lhs \ rhs;
    public WrappingDivide: <T, U> (lhs: T, rhs: U) -> _ ==> lhs \% rhs;
    public SaturatingDivide: <T, U> (lhs: T, rhs: U) -> _ ==> lhs \| rhs;
    public StrictDivide: <T, U> (lhs: T, rhs: U) -> _ ==> lhs \! rhs;
    public CheckedDivide: <T, U> (lhs: T, rhs: U) -> _ ==> lhs \? rhs;
    public OverflowingDivide: <T, U> (lhs: T, rhs: U) -> _ ==> lhs \%? rhs;
    public Remainder: <T, U> (lhs: T, rhs: U) -> _ ==> lhs % rhs;
    public WrappingRemainder: <T, U> (lhs: T, rhs: U) -> _ ==> lhs %% rhs;
    public SaturatingRemainder: <T, U> (lhs: T, rhs: U) -> _ ==> lhs %| rhs;
    public StrictRemainder: <T, U> (lhs: T, rhs: U) -> _ ==> lhs %! rhs;
    public CheckedRemainder: <T, U> (lhs: T, rhs: U) -> _ ==> lhs %? rhs;
    public OverflowingRemainder: <T, U> (lhs: T, rhs: U) -> _ ==> lhs %%? rhs;
    public RoundDiv: <T, U> (lhs: T, rhs: U) -> _ ==> lhs /~ rhs;
    public CeilDiv: <T, U> (lhs: T, rhs: U) -> _ ==> lhs /> rhs;
    public FloorDiv: <T, U> (lhs: T, rhs: U) -> _ ==> lhs /< rhs;
    public FloorMod: <T, U> (lhs: T, rhs: U) -> _ ==> lhs %< rhs;
    public DivRem: <T, U> (lhs: T, rhs: U) -> _ ==> lhs /% rhs;
    public Abs: <T> (lhs: T) -> _ ==> lhs.Abs;
    public WrappingAbs: <T> (lhs: T) -> _ ==> lhs.WrappingAbs;
    public SaturatingAbs: <T> (lhs: T) -> _ ==> lhs.SaturatingAbs;
    public StrictAbs: <T> (lhs: T) -> _ ==> lhs.StrictAbs;
    public CheckedAbs: <T> (lhs: T) -> _ ==> lhs.CheckedAbs;
    public OverflowingAbs: <T> (lhs: T) -> _ ==> lhs.OverflowingAbs;
    public Clamp: <T, U, V> (lhs: T, min: U, max: V) -> decay(T) ==> Max(Min(lhs, max), min);
    public Lerp: <T, U, V> (lhs: T, rhs: U, scale: V) -> decay(T) ==> lhs.Lerp(rhs, scale);
    public Sign: <T> (lhs: T) -> decay(T) ==> lhs.Sign;
    public CopySign: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs.CopySign(rhs);
    public IsPow2: <T> (lhs: T) -> bool ==> lhs.IsPow2;
    public NextPow2: <T> (lhs: T) -> decay(T) ==> lhs.NextPow2;
    public PrevPow2: <T> (lhs: T) -> decay(T) ==> lhs.PrevPow2;
    public IsMultipleOf: <T, U> (lhs: T, rhs: U) -> bool ==> lhs.IsMultipleOf(rhs);
    public NextMultipleOf: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs.NextMultipleOf(rhs);
    public Midpoint: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs.Midpoint(rhs);
    public Round: <T> (lhs: T) -> decay(T) ==> lhs.Round;
    public RoundTiesEven: <T> (lhs: T) -> decay(T) ==> lhs.RoundTiesEven;
    public Truncate: <T> (lhs: T) -> decay(T) ==> lhs.Truncate;
    public Ceil: <T> (lhs: T) -> decay(T) ==> lhs.Ceil;
    public Floor: <T> (lhs: T) -> decay(T) ==> lhs.Floor;
    public Log2: <T> (lhs: T) -> decay(T) ==> lhs.Log2;
    public Log10: <T> (lhs: T) -> decay(T) ==> lhs.Log10;
    public Ln: <T> (lhs: T) -> decay(T) ==> lhs.Ln;
    public Ln1P: <T> (lhs: T) -> decay(T) ==> lhs.Ln1P;
    public Log: <T, V> (lhs: T, base: V) -> decay(T) ==> lhs.Log(base);
    public Exp2: <T> (lhs: T) -> decay(T) ==> lhs.Exp2;
    public Exp10: <T> (lhs: T) -> decay(T) ==> lhs.Exp10;
    public Exp: <T> (lhs: T) -> decay(T) ==> lhs.Exp;
    public ExpM1: <T> (lhs: T) -> decay(T) ==> lhs.ExpM1;
    public Sqrt: <T> (lhs: T) -> decay(T) ==> lhs.Sqrt;
    public Cbrt: <T> (lhs: T) -> decay(T) ==> lhs.Cbrt;
    public Hypot: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs.Hypot;
    public Root: <T, U> (lhs: T, exp: U) -> decay(T) ==> lhs.Root(exp);
    public Sin: <T> (lhs: T) -> decay(T) ==> lhs.Sin;
    public Cos: <T> (lhs: T) -> decay(T) ==> lhs.Cos;
    public Tan: <T> (lhs: T) -> decay(T) ==> lhs.Tan;
    public SinPi: <T> (lhs: T) -> decay(T) ==> lhs.SinPi;
    public CosPi: <T> (lhs: T) -> decay(T) ==> lhs.CosPi;
    public TanPi: <T> (lhs: T) -> decay(T) ==> lhs.TanPi;
    public Cot: <T> (lhs: T) -> decay(T) ==> lhs.Cot;
    public Sec: <T> (lhs: T) -> decay(T) ==> lhs.Sec;
    public Csc: <T> (lhs: T) -> decay(T) ==> lhs.Csc;
    public Asin: <T> (lhs: T) -> decay(T) ==> lhs.Asin;
    public Acos: <T> (lhs: T) -> decay(T) ==> lhs.Acos;
    public Atan: <T> (lhs: T) -> decay(T) ==> lhs.Atan;
    public Atan2: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs.Atan2(rhs);
    public Acot: <T> (lhs: T) -> decay(T) ==> lhs.Acot;
    public Asec: <T> (lhs: T) -> decay(T) ==> lhs.Asec;
    public Acsc: <T> (lhs: T) -> decay(T) ==> lhs.Acsc;
    public Sinh: <T> (lhs: T) -> decay(T) ==> lhs.Sinh;
    public Cosh: <T> (lhs: T) -> decay(T) ==> lhs.Cosh;
    public Tanh: <T> (lhs: T) -> decay(T) ==> lhs.Tanh;
    public Coth: <T> (lhs: T) -> decay(T) ==> lhs.Coth;
    public Sech: <T> (lhs: T) -> decay(T) ==> lhs.Sech;
    public Csch: <T> (lhs: T) -> decay(T) ==> lhs.Csch;
    public Asinh: <T> (lhs: T) -> decay(T) ==> lhs.Asinh;
    public Acosh: <T> (lhs: T) -> decay(T) ==> lhs.Acosh;
    public Atanh: <T> (lhs: T) -> decay(T) ==> lhs.Atanh;
    public Acoth: <T> (lhs: T) -> decay(T) ==> lhs.Acoth;
    public Asech: <T> (lhs: T) -> decay(T) ==> lhs.Asech;
    public Acsch: <T> (lhs: T) -> decay(T) ==> lhs.Acsch;
    public Max: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs > rhs ? lhs : T(rhs);
    public Min: <T, U> (lhs: T, rhs: U) -> decay(T) ==> lhs < rhs ? lhs : T(rhs);
}

test "Math" {
    assert i32.MaxValue == 2147483647;
    assert 120.IsMultipleOf(12i16);
    assert 120.Max(115) == 120;

    f := Math.Isqrt8(250u8);
    assert f == 15;
    f1 := Math.Isqrt16(50000u16);
    assert f1 == 223;
    f2 := Math.Isqrt32(3_000_000_000u);
    assert f2 == 54772;
    f3 := Math.Isqrt64(10_000_000_000_000_000_000u);
    assert f3 == 3_162_277_660;
    f4 := Math.Isqrt128(100_000_000_000_000_000_000_000_000_000_000_000u);
    assert f4 == 316227766016837933;
}