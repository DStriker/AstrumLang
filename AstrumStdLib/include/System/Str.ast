package System;

public import CharIterator;
public import StringComparison;
public import System.Text.Utf8;

public type Utf8ValidationError = (index: usize, length: usize);

public extension byte[&] {
    // Returns true if the byte sequence is a valid ASCII string.
    IsAscii: bool == {
        if consteval {
            for b in this {
                if b not in ..=127u8 {
                    return false;
                }
            }
            return true;
        } else {
            return not this.ContainsAnyExcept(..=127u8);
        }
    }
}

public extension str {
    // Returns the number of UTF-8 bytes in the string.
    // For number of chars or grapheme clusters, use the appropriate methods.
    ByteLength: usize ==> this.GetByteLength();

    // Represents a string as byte array, efficient for ASCII text processing.
    Bytes: byte[&] ==> Span<byte>.UnsafeCreate(this.GetDataReference(), this.GetByteLength());

    // Returns the slice of string in given byte range
    // Throws InvalidArgumentException if the range bound is not a UTF-8 codepoint boundary.
    this[range: IndexRange] -> self == {
        let strLen := this.ByteLength;
        let start := range.Start.Offset(strLen) as usize;
        let len := range.Length(strLen);

        if (start + len) > strLen {
            throw Builtin.IndexOutOfRangeException();
        }
        if not this.Bytes[@Unchecked start].IsUtf8CodePointBoundary
            or not this.Bytes[@Unchecked start + len].IsUtf8CodePointBoundary {
            throw Builtin.InvalidArgumentException();
        }
        return str.UnsafeCreate(this.Bytes[@Unchecked start], len);
    }
    @Unchecked
    this[range: IndexRange] -> self == {
        return str.UnsafeCreate(Unsafe.Add(this.GetDataReference(), range.Start.Offset(this.ByteLength) as usize),
            range.Length(this.ByteLength));
    }

    // Returns a sequence of Unicode codepoints from the string.
    Chars: CharIterator ==> CharIterator(this);
    // Returns the number of Unicode codepoints in the string.
    CharCount: usize == {
        count: usize;
        for c in this.Chars {
            ++count;
        }

        return count;
    }
    // GraphemeClusters

    // Returns a slice of string in given char range starting from start to the end of the string
    Substring: (start: usize) -> self == {
        if start >= this.ByteLength {
            throw Builtin.IndexOutOfRangeException();
        }
        if not this.Bytes[@Unchecked start].IsUtf8CodePointBoundary {
            throw Builtin.InvalidArgumentException();
        }
        return str.UnsafeCreate(this.Bytes[@Unchecked start], this.ByteLength - start);
    }
    // Returns a slice of string in given char range starting from start with given length
    Substring: (start: usize, length: usize) -> self == {
        let end := start + length;
        if end > this.ByteLength {
            throw Builtin.IndexOutOfRangeException();
        }
        if not this.Bytes[@Unchecked start].IsUtf8CodePointBoundary
            or not this.Bytes[@Unchecked end].IsUtf8CodePointBoundary {
            throw Builtin.InvalidArgumentException();
        }
        return str.UnsafeCreate(this.Bytes[@Unchecked start], length);
    }

    Equals: (other: str) -> bool ==> this == other;
    /*Equals: (other: str, comparison: StringComparison) -> bool =
    {
        if this === other {
            return true;
        }

        if not this or not other or this.ByteLength != other.ByteLength {
            return false;
        }

        return switch comparison {
            ::Invariant or ::InvariantIgnoreCase => CompareInfo.Invariant.Compare(this, other, comparison == ::InvariantIgnoreCase) == 0,
            ::CurrentCulture or ::CurrentCultureIgnoreCase => CultureInfo.CurrentCulture.CompareInfo.Compare(this, other, comparison == ::CurrentCultureIgnoreCase) == 0,
            ::Ordinal => EqualsOrdinalHelper(this, other),
            ::OrdinalIgnoreCase => EqualsOrdinalIgnoreCaseHelper(this, other),
            _ => throw Builtin.InvalidArgumentException()
        };
    }
    Compare: (other: str) -> i32 ==> this <=> other;
    Compare: (other: str, comparison: StringComparison) -> i32 =
    {
        if this === other {
            return 0;
        }

        if not this {
            return -1;
        }

        if not other {
            return 1;
        }

        return switch comparison {
            ::Invariant or ::InvariantIgnoreCase => CompareInfo.Invariant.Compare(this, other, comparison == ::InvariantIgnoreCase),
            ::CurrentCulture or ::CurrentCultureIgnoreCase => CultureInfo.CurrentCulture.CompareInfo.Compare(this, other, comparison == ::CurrentCultureIgnoreCase),
            ::Ordinal => CompareOrdinalHelper(this, other),
            ::OrdinalIgnoreCase => CompareOrdinalIgnoreCaseHelper(this, other),
            _ => throw Builtin.InvalidArgumentException()
        };
    }*/
    
    // Converts the raw bytes to a str with validation
    // Retuns the converted str or Utf8ValidationError if bytes contains invalid UTF-8
    static TryFromUtf8: (bytes: byte[&]) -> self? == {
        return null;
    }
    // Converts the raw bytes to a str with validation
    // Throws InvalidArgumentException if bytes contains invalid UTF-8
    static FromUtf8: (bytes: byte[&]) -> self == {
        if let s := str.TryFromUtf8(bytes) {
            return s;
        }
        throw Builtin.InvalidArgumentException();
    }

    // Converts the raw bytes to a str without encoding validation
    // This is unsafe and should only be used when you are sure the bytes are valid UTF-8
    static FromUtf8Unchecked: (bytes: byte[&]) -> self noexcept == {
        return Unsafe.As<self>(bytes);
    }

    // Returns true if str contains only ASCII characters.
    IsAscii: bool ==> this.Bytes.IsAscii;
    // Returns true if str contains the given byte.
    Contains: (val: byte) -> bool ==> this.Bytes.Contains(val);
    operator in: (val: byte) -> bool ==> this.Bytes.Contains(val);
    // Returns true if str contains the given character.
    Contains: (val: char) -> bool == {
        if val.IsAscii {
            return this.Bytes.Contains(val as byte);
        }
        buf: byte[4u];
        return /*this.Contains(val.ToUtf8(buf))*/false;
    }
    operator in: (val: char) -> bool ==> this.Contains(val);
    // HashCode
    // IndexOf, IndexOfAny
    // LastIndexOf, LastIndexOfAny
    // IsNormalized
    // IsWhiteSpace
    // IsUpper, IsLower
    // Normalize
    // Split
    // StartsWith
    // Trim
}


static assert(sizeof(str) == sizeof(usize) * 2, "str should be 2 pointers wide");
static assert(type str is ISelfEquatable, "str should be ISelfEquatable");
static assert(type str is IEquatable<str>, "str should be IEquatable<str>");
static assert(type str is ISelfComparable, "str should be ISelfComparable");
static assert(type str is IComparable<str>, "str should be IComparable<str>");

private const cs: str == "Hello, моя Лерка ❤😆";
private const test1 :== "PART 1";
private const test2 :== "PART 2";
private const test3 :== "Begin " + test1 + " Middle " + test2 + " End";
static assert(test3 == "Begin PART 1 Middle PART 2 End", "str concatenation failed");
private const arr: str[_] == [ "Hello", "world", "!" ];
static assert(arr[0] == "Hello", "str array indexing failed");
static assert(arr.Length == 3, "str array length failed");

test "Str" {
    s: str = "Hello, world!";
    assert s == "Hello, world!";
    assert s < "Help";
    assert s.ByteLength == 13;
    assert cs.ByteLength == 32;
    assert cs.CharCount == 19;
    assert "My dog is wolf!".ByteLength == 15;
    const s3 : str == "Begin " + test1 + " Middle " + test2 + " End";
    assert s3.ByteLength == 30;
    assert s[1u..^1u] == "ello, world";
    assert "Help".Substring(2u) == "lp";
    assert s.Substring(1u, 11u) == "ello, world";
    assert b'w' in s;
    assert b'f' not in s;
    assert s.IsAscii;
    assert not cs.IsAscii;

    let switched := switch s {
        "Help" => "help",
        "Hello, world!" => "hello",
        _ => "unknown"
    };
    assert switched == "hello";
}
