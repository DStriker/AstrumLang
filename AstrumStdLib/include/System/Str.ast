package System;

public import IEquatable;

public ref struct Str2: IEquatable<Str2> {
    private _data: &byte;
    private _length: usize;

    operator== := default;
}

public ref struct <T> TestRef {
    private _data: T;
}

r: (ref a: i32, b: i32) -> ref i32 {
    c := 5;
    b = c;
    return &a;
}

f: () -> i32 { 
    i := 5;
    k := 10;
    ri: &mut i32 = &i;
    rj: &i32 = i;
    {
        j := 6;
        k = 5;
        k = j;
        rj = &k;
        ri = 5;
        print(rj);
    }
    return 6; 
}

test "Str" {
    i := 5;
    j := f();
    s: Str2;
    //ri: &i32 = i;
    ri: &mut i32 = &i;
    ri = 8;
    print(i);
    print(ri);
    i = 6;
    print(i);
    print(ri);
    ri = 2;
    print(i);
    j = ri;
    print(ri);
    print(j);
    j = 12;
    ri = &j;
    ri = 18;
    print(ri + 5);
    print(i);
    print(j);
}
