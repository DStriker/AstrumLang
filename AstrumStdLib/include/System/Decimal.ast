private union struct Buf12 {
    public this() noexcept {}

    private struct DWordsStruct {
        public u0, u1, u2: u32;
    }
    public DWords: DWordsStruct;

    private ulo64: u64;

    if version(BIG_ENDIAN) {
        public unsafe Low64: u64 {
            get => u64(DWords.u1) << 32 | DWords.u0;
            set = {
                DWords.u1 = u32(value >> 32);
                DWords.u0 = value.NarrowToUInt32();
            }
        }
    } else {
        public unsafe Low64: u64 {
            get => ulo64;
            set => ulo64 = value;
        }
    }
    public unsafe High64: u64 {
        get => u64(DWords.u2) << 32 | DWords.u1;
        set = {
            DWords.u2 = u32(value >> 32);
            DWords.u1 = value.NarrowToUInt32();
        }
    }
}

private union struct Buf16 {
    public this() noexcept {}

    private struct DWordsStruct {
        public u0, u1, u2, u3: u32;
    }
    public DWords: DWordsStruct;

    private struct QWordsStruct {
        public ulo, uhi: u64;
    }
    private QWords: QWordsStruct;

    if version(BIG_ENDIAN) {
        public unsafe Low64: u64 {
            get => u64(DWords.u1) << 32 | DWords.u0;
            set = {
                DWords.u1 = u32(value >> 32);
                DWords.u0 = value.NarrowToUInt32();
            }
        }
        public unsafe High64: u64 {
            get => u64(DWords.u3) << 32 | DWords.u2;
            set = {
                DWords.u3 = u32(value >> 32);
                DWords.u2 = value.NarrowToUInt32();
            }
        }
    } else {
        public unsafe Low64: u64 {
            get => QWords.ulo;
            set => QWords.ulo = value;
        }
        public unsafe High64: u64 {
            get => QWords.uhi;
            set => QWords.uhi = value;
        }
    }
}

private union struct Buf24 {
    public this() noexcept {}

    private struct DWordsStruct {
        public u0, u1, u2, u3, u4, u5: u32;
    }
    public DWords: DWordsStruct;

    private struct QWordsStruct {
        public ulo, umid, uhi: u64;
    }
    private QWords: QWordsStruct;

    if version(BIG_ENDIAN) {
        public unsafe Low64: u64 {
            get => u64(DWords.u1) << 32 | DWords.u0;
            set = {
                DWords.u1 = u32(value >> 32);
                DWords.u0 = value.NarrowToUInt32();
            }
        }
        public unsafe Mid64: u64 {
            get => u64(DWords.u3) << 32 | DWords.u2;
            set = {
                DWords.u3 = u32(value >> 32);
                DWords.u2 = value.NarrowToUInt32();
            }
        }
        public unsafe High64: u64 {
            get => u64(DWords.u5) << 32 | DWords.u4;
            set = {
                DWords.u5 = u32(value >> 32);
                DWords.u4 = value.NarrowToUInt32();
            }
        }
    } else {
        public unsafe Low64: u64 {
            get => QWords.ulo;
            set => QWords.ulo = value;
        }
        public unsafe Mid64: u64 {
            get => QWords.umid;
            set => QWords.umid = value;
        }
        public unsafe High64: u64 {
            get => QWords.uhi;
            set => QWords.uhi = value;
        }
    }
    public const LENGTH :== 6;
}

private struct Buf28 {
    public buf24: Buf24;
    public u6: u32;

    public const LENGTH :== 7;

    public this() noexcept = default;
}

private const DEC_SCALE_MAX :== 28;
private unsafe ScaleResult: (buf: *Buf24, hi: u32, scale: i32) -> i32 {
    assert hi < Buf24.LENGTH;

    result := UnsafePointerCast<u32>(buf);
    newScale := 0;
    if hi > 2u {
        newScale = hi.NarrowToInt32() *% 32 -% 64 -% 1;
        newScale -= result[hi].LeadingZeroCount;
        newScale = ((newScale *% 77) >> 8) +% 1;

        if newScale > scale {
            throw Builtin.DecimalOverflowException();
        }
    }

    if newScale < scale - DEC_SCALE_MAX {
        newScale = scale - DEC_SCALE_MAX;
    }

    if newScale != 0 {
        scale -= newScale;
        sticky, quotient, remainder: u32;

        divByConst := (pow: u32) -> u32 {
            let high := result[hi];
            quotient = high \ pow;
            remainder = high -% quotient *% pow;
            for i := hi -% 1; i.NarrowToInt32() >= 0; --%i {
                static if Builtin.Is64BitTarget() {
                    let num := u64(result[i]) +% (u64(remainder) << 32);
                    result[i] = (num \ pow).NarrowToUInt32();
                    remainder = num.NarrowToUInt32() -% result[i] *% pow;
                } else {
                    assert pow <= u16.MaxValue;
                    if version(BIG_ENDIAN) {
                        const low16 :== 2u;
                        const high16 :== 0u;
                    } else {
                        const low16 :== 0u;
                        const high16 :== 2u;
                    }

                    num := u32(UnsafePointerCast<u16>(UnsafePointerCast<u8>(result) + i * 4 + high16)*) +% (remainder << 16);
                    div := num \ pow;
                    remainder = num -% div *% pow;
                    UnsafePointerCast<u16>(UnsafePointerCast<u8>(result) + i * 4 + high16)* = div.NarrowToUInt32();

                    num = u32(UnsafePointerCast<u16>(UnsafePointerCast<u8>(result) + i * 4 + low16)*) +% (remainder << 16);
                    div := num \ pow;
                    remainder = num -% div *% pow;
                    UnsafePointerCast<u16>(UnsafePointerCast<u8>(result) + i * 4 + low16)* = div.NarrowToUInt32();
                }
            }
            return pow;
        };

        for {
            sticky |= remainder;
            power: u32;

            static if Builtin.Is64BitTarget() {
                power = switch newScale {
                    1 => divByConst(10u),
                    2 => divByConst(100u),
                    3 => divByConst(1000u),
                    4 => divByConst(10000u),
                    5 => divByConst(100000u),
                    6 => divByConst(1000000u),
                    7 => divByConst(10000000u),
                    8 => divByConst(100000000u),
                    _ => divByConst(1000000000u)
                };
            } else {
                power = switch newScale {
                    1 => divByConst(10u),
                    2 => divByConst(100u),
                    3 => divByConst(1000u),
                    _ => divByConst(10000u)
                };
            }

            result[hi] = quotient;
            if quotient == 0 and hi != 0 {
                hi--%;
            }

            static if Builtin.Is64BitTarget() {
                newScale -= 9;
            } else {
                newScale -= 4;
            }

            if newScale > 0 {
                continue;
            }

            if hi > 2u {
                if (scale == 0)
                    throw Builtin.DecimalOverflowException();

                newScale = 1;
                scale--;
                continue;
            }

            power >>= 1;
            if power <= remainder and (power < remainder or ((result[0u] & 1u) | sticky) != 0) and ++%result[0u] == 0u {
                cur := 0u;
                do {
                    assert cur + 1u < Buf24.LENGTH;
                } while ++%result[++cur] == 0u;

                if cur > 2u {
                    if (scale == 0)
                        throw Builtin.DecimalOverflowException();

                    hi = cur;
                    sticky = 0u;
                    remainder = 0u;
                    newScale = 1;
                    scale--;
                    continue;
                }
            }
            break;
        }
    }

    return scale;
}

private struct PowerOvfl {
    public Hi: u32;
    public MidLo: u64;

    public this() noexcept == default;
    public this(hi: u32, mid: u32, lo: u32) noexcept == {
        this.Hi = hi;
        this.MidLo = (u64(mid) << 32) | u64(lo);
    }
}

private let PowerOvflValues: PowerOvfl[_] = [
    { 429496729u, 2576980377u, 2576980377u },
    { 42949672u,  4123168604u, 687194767u  },
    { 4294967u,   1271310319u, 2645699854u },
    { 429496u,    3133608139u, 694066715u  },
    { 42949u,     2890341191u, 2216890319u },
    { 4294u,      4154504685u, 2369172679u },
    { 429u,       2133437386u, 4102387834u },
    { 42u,        4078814305u, 410238783u  }
];

private unsafe SearchScale: (ref buf: Buf12, scale: i32) -> i32
{
    const OVFL_MAX_9_HI :== 4u;
    const OVFL_MAX_8_HI :== 42u;
    const OVFL_MAX_7_HI :== 429u;
    const OVFL_MAX_6_HI :== 4294u;
    const OVFL_MAX_5_HI :== 42949u;
    const OVFL_MAX_4_HI :== 429496u;
    const OVFL_MAX_3_HI :== 4294967u;
    const OVFL_MAX_2_HI :== 42949672u;
    const OVFL_MAX_1_HI :== 429496729u;
    const OVFL_MAX_9_MIDLO :== 5441186219426131129u;

    let hi := buf.DWords.u2;
    let midLo := buf.Low64;
    currentScale := 0;

    haveScale := () {
        if currentScale + scale < 0 {
            throw Builtin.DecimalOverflowException();
        }

        return currentScale;
    };

    if hi > OVFL_MAX_1_HI {
        return haveScale();
    }

    if scale > DEC_SCALE_MAX - 9 {
        currentScale = DEC_SCALE_MAX - scale;
        if hi < PowerOvflValues[usize(currentScale - 1)].Hi {
            return haveScale();
        }
    } else if hi < OVFL_MAX_9_HI or hi == OVFL_MAX_9_HI and midLo <= OVFL_MAX_9_MIDLO {
        return 9;
    }

    if hi > OVFL_MAX_5_HI {
        if hi > OVFL_MAX_3_HI {
            currentScale = 2;
            if hi > OVFL_MAX_2_HI {
                currentScale--;
            }
        } else {
            currentScale = 4;
            if hi > OVFL_MAX_4_HI {
                currentScale--;
            }
        }
    } else {
        if hi > OVFL_MAX_7_HI {
            currentScale = 6;
            if hi > OVFL_MAX_6_HI {
                currentScale--;
            }
        } else {
            currentScale = 8;
            if hi > OVFL_MAX_8_HI {
                currentScale--;
            }
        }
    }

    if hi == PowerOvflValues[usize(currentScale - 1)].Hi and midLo > PowerOvflValues[usize(currentScale - 1)].MidLo {
        currentScale--;
    }

    return haveScale();
}

private inline Unscale: (ref low: u32, ref high: u64, ref scale: i32) noexcept
{
    divByConst := (pow: u32) {
        static if Builtin.Is64BitTarget() {
            let div64 := high \ pow;
            let div := ((((high -% div64 *% pow) << 32) +% low) \ pow).NarrowToUInt32();
            if low == div *% pow {
                high = div64;
                low = div;
                return true;
            }
        } else {
            assert pow <= u16.MaxValue;

            num, mid32, low16, div: u32;
            if high <= u32.MaxValue {
                num = high.NarrowToUInt32();
                mid32 = num \ pow;
                num = (num -% mid32 *% pow) << 16;
                num +%= low >> 16;
                low16 = num \ pow;
                num = (num -% low16 *% pow) << 16;
                num +%= low.NarrowToUInt16();
                div = num \ pow;
                if num == div *% pow {
                    high = mid32;
                    low = (low16 << 16) +% div;
                    return true;
                }
            } else {
                num = (high >> 32).NarrowToUInt32();
                let high32 := num \ pow;
                num = (num -% high32 *% pow) << 16;
                num +%= high.NarrowToUInt32() >> 16;

                mid32 = num \ pow;
                num = (num -% mid32 *% pow) << 16;
                num +%= high.NarrowToUInt16();
                div = num \ pow;
                num = (num -% div *% pow) << 16;
                mid32 = div +% (mid32 << 16);

                num +%= low >> 16;
                low16 = num \ pow;
                num = (num -% low16 *% pow) << 16;

                num +%= low.NarrowToUInt16();
                div = num \ pow;
                if num == div *% pow {
                    high = (u64(high32) << 32) | mid32;
                    low = (low16 << 16) +% div;
                    return true;
                }
            }
        }
        return false;
    };

    static if Builtin.Is64BitTarget() {
        while low.NarrowToUInt8() == 0u and scale >= 8 and divByConst(100000000u) {
            scale -= 8;
        }
        if (low & 0xFu) == 0u and scale >= 4 and divByConst(10000u) {
            scale -= 4;
        }
    } else {
        while (low & 0xFu) == 0u and scale >= 4 and divByConst(10000u) {
            scale -= 4;
        }
    }

    if (low & 3u) == 0u and scale >= 2 and divByConst(100u) {
        scale -= 2;
    }

    if (low & 1u) == 0u and scale >= 1 and divByConst(10u) {
        scale--;
    }
}

private unsafe Div96By64: (ref buf: Buf12, den: u64) -> u32
{
    assert den > buf.High64;
    quo: u32;
    num: u64;

    let num2 := buf.DWords.u2;
    if num2 == 0u {
        num = buf.Low64;
        if num < den {
            return 0u;
        }

        quo = (num \ den).NarrowToUInt32();
        num -%= quo *% den;
        buf.Low64 = num;
        return quo;
    }

    let denHigh32 := u32(den >> 32);
    if num2 >= denHigh32 {
        num = buf.Low64;
        num -%= den << 32;
        quo = 0u;
        do {
            quo--%;
            num +%= den;
        } while num >= den;
        buf.Low64 = num;
        return quo;
    }

    let num64 := buf.High64;
    if num64 < denHigh32 {
        return 0u;
    }

    quo = (num64 \ denHigh32).NarrowToUInt32();
    num = u64(buf.DWords.u0) | ((num64 -% quo *% denHigh32) << 32);

    let prod := u64(quo) *% den.NarrowToUInt32();
    num -%= prod;
    if num > (~prod) {
        do {
            quo--%;
            num +%= den;
        } while num >= den;
    }

    buf.Low64 = num;
    return quo;
}

private unsafe Div128By96: (ref buf: Buf16, ref bufDen: Buf12) -> u32
{
    assert bufDen.DWords.u2 > buf.DWords.u3;

    let dividend := buf.High64;
    let den := bufDen.DWords.u2;
    if dividend < den {
        return 0u;
    }

    quo := (dividend \ den).NarrowToUInt32();
    remainder := dividend.NarrowToUInt32() -% quo *% den;
    prod1 := u64(quo) *% bufDen.DWords.u0;
    prod2 := u64(quo) *% bufDen.DWords.u1;
    prod2 +%= prod1 >> 32;
    prod1 = u64(prod1.NarrowToUInt32()) | (prod2 << 32);
    prod2 >>= 32;

    num := buf.Low64;
    num -%= prod1;
    remainder -%= prod2.NarrowToUInt32();

    posRem := () {
        buf.Low64 = num;
        buf.DWords.u2 = remainder;
        return quo;
    };

    if num > (~prod1) {
        remainder--%;
        if remainder < (~prod2.NarrowToUInt32()) {
            return posRem();
        }
    } else if remainder <= (~prod2.NarrowToUInt32()) {
        return posRem();
    }

    prod1 = bufDen.Low64;
    for {
        quo--%;
        num +%= prod1;
        remainder +%= den;
        if num < prod1 {
            if (remainder++% < den)
                break;
        }
        if (remainder < den)
            break;
    }

    return posRem();
}

private printd: (d: decimal)
{
    let sign := d.IsNegative;
    let scale := d.Scale;
    mantissa := Builtin.BitCast<u128>(d) & 0xffffffff_ffffffff_ffffffff_00000000_u128;
    let high := mantissa.Low64() >> 32;
    let low := mantissa.High64();
    mantissa = u128(high, low);

    printDecimal(mantissa, sign, scale);
}

static assert(sizeof(Decimal) == 16, "Decimal should be 16 bytes");

test "Decimal" {
    d: decimal;
    d = -1.2345 as decimal;
    
    assert +d == -1.2345m;
    assert -d == 1.2345m;
    assert 0.1m + 0.2m == 0.3m;
    assert 0.3m - 0.2m == 0.1m;
    assert d + 1.23m == -0.0045m;
    assert d - 1.2345m == -2.4690m;
    d += 1.0m;
    assert d == -0.2345m;
    d -= 1.0m;
    assert d == -1.2345m;
    assert d++ == -1.2345m;
    assert ++d == 0.7655m;
    assert d-- == 0.7655m;
    assert --d == -1.2345m;

    assert 123.456m + 123456789123456789.123456789m == 123456789123456912.579456789m;
    assert 123.456m - 123456789123456789.123456789m == -123456789123456665.667456789m;

    assert d * 2 == -2.4690m;
    assert d * 2.0m == -2.46900m;
    assert 10.250m * 0.5m == 5.1250m;
    assert d * (-2.0m) == 2.46900m;
    assert 123.456m * 456.789m == 56393.342784m;
    d *= 2.123m;
    assert d == -2.6208435m;

    d = -12.500m;
    assert d == -12.5m;
    assert d != -12.4m;
    assert d < -12.4m;
    assert d > -12.6m;
    assert d <= -12.4m;
    assert d >= -12.6m;

    assert d / 2.5m == -5.00m;
    assert d / 2 == -6.250m;
    assert d / (-2.0m) == 6.25m;
    assert 123456789123456789.123456789m / 123456.123456m == 1000005391935.5164781973695622m;
    assert 123456789123456789.123456789m / (-123456.123456m) == -1000005391935.5164781973695622m;
    assert (-123456789123456789.123456789m) / (-123456.123456m) == 1000005391935.5164781973695622m;
    assert 123456789123456789.123456789m / 123456123456.123456123456m == 1000005.3919345164728054350457m;
    assert 123.456m / 0.123456789m == 999.9936090999418428094707696m;
    d /= 2.5m;
    assert d == -5.00m;
    assert d % 2 == -1.00m;
    assert (-5.00m) % 2.123m == -0.754m;
    assert 123456789123456789.123456789m % 123456123456.123456123456m == 48386716052.382720171720m;
    d %= 2;
    assert d == -1.00m;

    d = -1.2345m;
    assert d == -1.2345m;
    assert d.Truncate == -1;
    assert 2.678m.Truncate == 2;
    assert d.TruncateToInt32() == -1;
    assert d.Floor == -2;
    assert d.FloorToInt32() == -2;
    assert 2.678m.Floor == 2;
    assert d.Ceil == -1;
    assert d.CeilToInt32() == -1;
    assert 2.678m.Ceil == 3;
    assert d.Round == -1;
    assert d.RoundToInt32() == -1;
    assert d.RoundTiesEven == -1;
    assert d.RoundTiesEvenToInt32() == -1;
    assert 2.678m.Round == 3;
    assert 2.5m.Round == 3;
    assert 2.5m.RoundTiesEven == 2;
    assert d.Round(2u) == -1.23m;

    d = 123456789123456789.123456789m;
    bits := d.Bits;
    assert bits[0u] == 2080661269u;
    assert bits[1u] == 4075008415u;
    assert bits[2u] == 6692605u;
    assert bits[3u] == 589824u;

    assert 12.345m ** 3.475m == 6207.7118925179657394820798383m;
    assert 12.345m.Exp == 229808.12486124595475041888612m;
    assert 12.345m.Exp2 == 5202.5384244788822035143417228m;
    assert 12.345m.Exp10 == 2213094709605.6377223339808814m;
    assert 12.345m.Ln == 2.5132511227971428258519031703m;
    assert 12.345m.Log2 == 3.6258549313680571627010290442m;
    assert 12.345m.Log10 == 1.0914910942679510818489967645m;
    assert 12.345m.Log(4) == 1.8129274656840285813505145227m;
    assert 12.345m.Sqrt == 3.5135452181521728638212225535m;
    assert 123.345m.Root(5) == 2.6195356295079193440029636649m;
    assert 12.345m.Hypot(13.475m) == 18.274973324193937110010809348m;
    assert 12.345m.Sin == -0.2195669967379331208777903957m;
    assert 12.345m.Cos == 0.9755974241168764311137172336m;
    assert 12.345m.Tan == -0.2250590164654114812867215792m;
    assert 0.345m.Asin == 0.3522387850970647507525367312m;
    assert 0.345m.Acos == 1.2185575416978318684787849604m;
    assert 0.345m.Atan == 0.3322135507465967447407006541m;
    assert 12.345m.Sinh == 114904.06242844724925288177915m;
    assert 12.345m.Cosh == 114904.06243279870549753710697m;
    assert 12.345m.Tanh == 0.9999999999621296571024173851m;
    assert 12.345m.Asinh == 3.2080347119330812566459538762m;
    assert 12.345m.Acosh == 3.2047538216182560379240045553m;
    assert 0.345m.Atanh == 0.3597570282003437810352645844m;

}
